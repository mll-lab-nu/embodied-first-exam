(define (problem configuration_matching-1)
    (:domain ispatialgym)
    (:variant configuration_matching-attachment-lid-teapot-bar)

    ; Configuration matching - attachment. Target = male part (grasped), partner = female part (stands on the support, braced
    ; by the other gripper while attaching). The assembly group carries the fixed member-to-slot layout target; the
    ; partner's pose stays as at init. Male / female pairs with matching BEHAVIOR attachment meta-links come from
    ; roles/constraints_compatible.csv (partner_of, attach_type); the partner brace is computed geometrically (no artefact).

    (:objects
        lid.n.02_1 - lid.n.02
        teapot.n.01_1 - teapot.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        lid.n.02_1 teapot.n.01_1 - assembly_group.n.01_1
    )

    (:init
        (ontop assembly_group.n.01_1 countertop.n.01_1)
        (not (attached lid.n.02_1 teapot.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (attached ?lid.n.02_1 ?teapot.n.01_1)
            (ontop ?teapot.n.01_1 ?countertop.n.01_1)
            (layout_reached ?assembly_group.n.01_1)
            (not (grasped ?agent.n.01_1 ?assembly_group.n.01_1))
            (pose_settled ?assembly_group.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?assembly_group.n.01_1)
        (layout_reached ?assembly_group.n.01_1)
    )
)
