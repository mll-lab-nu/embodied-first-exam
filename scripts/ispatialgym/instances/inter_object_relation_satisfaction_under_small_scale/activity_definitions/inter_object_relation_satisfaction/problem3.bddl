(define (problem inter_object_relation_satisfaction-3)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-touching_small_scale-box_of_sanitary_napkins-box_of_tissues-breakfast_table)

    ; IORS - touching (small-scale). Target grasped and set down next to the partner (partner on the robot's left), then
    ; pushed against it while the other gripper braces the partner's far side (push and brace computed geometrically, no
    ; artefact); the partner must not move (> 5 mm) at the goal.

    (:objects
        box__of__sanitary_napkin.n.01_1 - box__of__sanitary_napkin.n.01
        box__of__tissue.n.01_1 - box__of__tissue.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop box__of__sanitary_napkin.n.01_1 breakfast_table.n.01_1)
        (ontop box__of__tissue.n.01_1 breakfast_table.n.01_1)
        (not (touching box__of__sanitary_napkin.n.01_1 box__of__tissue.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (touching ?box__of__sanitary_napkin.n.01_1 ?box__of__tissue.n.01_1)
            (not (grasped ?agent.n.01_1 ?box__of__sanitary_napkin.n.01_1))
            (not (grasped ?agent.n.01_1 ?box__of__tissue.n.01_1))
            (pose_settled ?box__of__sanitary_napkin.n.01_1)
            (pose_settled ?box__of__tissue.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?box__of__sanitary_napkin.n.01_1)
        (pose_reached ?box__of__tissue.n.01_1)
    )
)
