(define (problem configuration_matching-11)
    (:domain ispatialgym)
    (:variant configuration_matching-block_design-block_4-breakfast_table_board)

    ; The four Kohs blocks are placed into the pocket of a wooden board (tray/isgboard, ispatialgym-assets: a plate with a
    ; 12 mm rim around a 9 cm square pocket) standing on the breakfast table, then pushed against the pocket's far / left
    ; walls so they end packed; the blocks' goal support is the board. The board is a member of targets_group (pinned to
    ; its own slot in the instance file), so layout_reached judges the blocks relative to the board; ontop is per block
    ; (on the group it would also put the board on itself).

    (:objects
        toy_dice.n.01_1 toy_dice.n.01_2 toy_dice.n.01_3 toy_dice.n.01_4 - toy_dice.n.01
        tray.n.01_1 - tray.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:groups
        toy_dice.n.01_1 toy_dice.n.01_2 toy_dice.n.01_3 toy_dice.n.01_4 tray.n.01_1 - targets_group.n.01_1
    )

    (:init
        (ontop targets_group.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop ?toy_dice.n.01_1 ?tray.n.01_1)
            (ontop ?toy_dice.n.01_2 ?tray.n.01_1)
            (ontop ?toy_dice.n.01_3 ?tray.n.01_1)
            (ontop ?toy_dice.n.01_4 ?tray.n.01_1)
            (layout_reached ?targets_group.n.01_1)
            (not (grasped ?agent.n.01_1 ?targets_group.n.01_1))
            (pose_settled ?targets_group.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?targets_group.n.01_1)
        (layout_reached ?targets_group.n.01_1)
    )
)
