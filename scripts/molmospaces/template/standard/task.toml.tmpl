schema_version = "1.3"
artifacts = [
  { source = "/data/final.json", service = "sim" },
  { source = "/data/episode.jsonl", service = "sim" },
  { source = "/data/trajectory.npz", service = "sim" },
  { source = "/data/replay.mp4", service = "sim" },
  { source = "/data/server.log", service = "sim" },            # the service's own output (Harbor keeps none)
  { source = "/data/journal.f64", service = "sim" },           # crash recovery: every executed control step (float64 rows)
  { source = "/data/startups.jsonl", service = "sim" },        # crash recovery: one line per service start
  { source = "/data/replay1.log", service = "sim" },           # the collect hook's two fresh-process replays
  { source = "/data/replay2.log", service = "sim" },
  { source = "/data/replay3.log", service = "sim" },           # and its third, which renders replay.mp4
  "/app/output/",
]

[task]
name = "robot-coding-bench/@@STD@@"
description = "STANDARD MODE (robot as a service, eai-standard/2.2): MolmoSpaces @@FAMILY@@ on the same frozen episode as @@PRIV@@. @@GOAL_TOML@@ The agent only gets a client: camera images (RGB, depth) and proprioception, joint-position chunks, upstream's kinematic model, done. No reset, no object state; the sim service records the episode and grades it with upstream's success check."
authors = [{ name = "pingyue" }]
keywords = ["robotics", "molmospaces", "mujoco", "@@ROBOT_TAX@@", "standard-mode", "trajectory", "@@FAMILY@@"]

[metadata]
author_name = "pingyue"
task_type = "trajectory"
simulator = "molmospaces"
robot = "@@ROBOT_TAX@@"
family = "@@FAMILY@@"
mode = "standard"                  # robot as a service: images + proprioception only; no object poses, no success check, no reset
protocol = "eai-standard/2.2"
expert_time_estimate_hours = 3.0
oracle = "none"
oracle_evidence = "@@ORACLE_EVIDENCE@@"

[verifier]
timeout_sec = 600.0
environment_mode = "separate"
network_mode = "no-network"

[[verifier.collect]]
service = "sim"
command = "sh /srv/finalize.sh"   # end + dump + exit the service, replay twice in fresh processes, write final.json, video
timeout_sec = 1800                # the end (up to 900 s through a resume) + replays of 20-120 s each (over 500 s on a loaded
                                  # host); finalize.sh shares the time left before 1740 s between the two grading replays
                                  # and never runs one past it, so final.json is always completed in time

[agent]
timeout_sec = 3600.0
network_mode = "allowlist"
allowed_hosts = ["chatgpt.com", "*.chatgpt.com", "auth.openai.com", "api.openai.com", "*.openai.com", "api.anthropic.com", "*.anthropic.com", "openrouter.ai", "*.openai.azure.com", "*.cognitiveservices.azure.com", "pypi.org", "files.pythonhosted.org", "deb.debian.org", "security.debian.org", "archive.ubuntu.com", "security.ubuntu.com", "snapshot.ubuntu.com"]

[environment]
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 16384
