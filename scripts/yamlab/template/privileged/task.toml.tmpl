# Generated by scripts/yamlab/mk_tasks.py -- edit the template or scripts/yamlab/instances.json, not this.
schema_version = "1.3"
artifacts = ["/app/output/"]

[task]
name = "robot-coding-bench/@@PRIV@@"
description = "YAMLab @@ENV@@ (two I2RT YAM arms with parallel grippers, Isaac Lab / Isaac Sim 5.1): produce one replayable trajectory of YAMLab's 14-D joint-position actions. @@GOAL_TOML@@ Frozen scene instance: @@ASSETS_TEXT@@, the recorded initial state of YAMLab teleoperation demonstration @@SOURCE@@; graded by YAMLab's own staged success check (evaluation thresholds)."
authors = [{ name = "Changhe Chen" }]
keywords = ["robotics", "yamlab", "isaac-lab", "isaac-sim", "bimanual", "i2rt-yam", "code-as-policy", "trajectory", "privileged"]

[metadata]
author_name = "Changhe Chen"
author_org = "MLL Lab"
task_type = "trajectory"
simulator = "yamlab"              # YAMLab @ ec0455d on Isaac Lab @ f4aa17f / Isaac Sim 5.1 (PhysX on the CPU, RTX rendering)
robot = "i2rt-yam-bimanual"
family = "@@FAMILY@@"
mode = "privileged"
oracle = "full"
expert_time_estimate_hours = 1.5

[verifier]
timeout_sec = 13000.0             # two fresh-process replays at tests/grade.py's limit for the longest accepted trajectory
                                  # (replay_timeout(100,000 rows) = 1200 s + rows / 20 = 6200 s each; the first Isaac start in
                                  # the verifier compiles shaders, 629 s measured) + 600 s; a usual trajectory (up to 12,000
                                  # rows) keeps the old 1800 s per replay
environment_mode = "separate"     # verifier runs in its own sandbox (tests/Dockerfile); the agent container is gone by then
network_mode = "no-network"       # Isaac Sim starts and renders offline: every asset is in the image (images/yamlab/web_assets.txt)

[verifier.environment]
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 24576

[agent]
timeout_sec = 5400.0              # YAMLab budget, both modes (docs/benchmarks/yamlab.md): every Python process pays ~1.5-2.5 min of Isaac Sim launch + scene build
# YAMLab's teleoperation demonstrations (which solve these exact instances) and its MimicGen datasets are public upstream,
# so the agent reaches the model APIs and nothing else (scripts/set_agent_egress.py HOSTS).
network_mode = "allowlist"
allowed_hosts = ["chatgpt.com", "*.chatgpt.com", "auth.openai.com", "api.openai.com", "*.openai.com", "api.anthropic.com", "*.anthropic.com", "openrouter.ai", "*.openai.azure.com", "*.cognitiveservices.azure.com"]

[environment]
build_timeout_sec = 3600.0
cpus = 8
memory_mb = 24576
