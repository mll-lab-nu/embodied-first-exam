              0.0,
              -2.3,
              0.0,
              -0.5,
              0.0,
              -0.05,
              -0.05
            ]
          }
        },
        "parts": {
          "torso": {
            "kind": "torso",
            "note": "9 values: the base's world pose targets base_x, base_y (m) and base_theta (rad, -pi..pi), then the torso joints torso_0..5 (rad); move the base itself with target base (dx, dy, dyaw)",
            "joints": {
              "type": "joint_position",
              "cols": [
                0,
                9
              ]
            },
            "state": {
              "joints": {
                "group": "joint_pos",
                "offset": 0,
                "n": 9
              }
            }
          },
          "left": {
            "kind": "arm",
            "note": "7 joints (left_arm_0..6, rad); end-effector pose = the grasp point between the fingertips (left_gripper); poses are solved by the service's IK, which moves this arm only (the torso too when the arm alone cannot reach); the gripper is force-commanded: 1 closes with the full finger force, 0 opens with it, 0.5 exerts none",
            "joints": {
              "type": "joint_position",
              "cols": [
                9,
                16
              ]
            },
            "gripper": {
              "type": "joint_position",
              "col": 23,
              "open": -100.0,
              "closed": 100.0
            },
            "ik": {
              "frame": "left_gripper",
              "seed": {
                "group": "joint_pos"
              },
              "q_cols": [
                9,
                16
              ]
            },
            "state": {
              "joints": {
                "group": "joint_pos",
                "offset": 9,
                "n": 7
              },
              "gripper_opening_m": {
                "names": [
                  "left_gripper_opening_m"
                ]
              },
              "ee_pose": {
                "group": "tcp_pose",
                "offset": 0,
                "n": 7
              }
            }
          },
          "right": {
            "kind": "arm",
            "note": "7 joints (right_arm_0..6, rad); end-effector pose = the grasp point between the fingertips (right_gripper); poses are solved by the service's IK, which moves this arm only (the torso too when the arm alone cannot reach); the gripper is force-commanded: 1 closes with the full finger force, 0 opens with it, 0.5 exerts none",
            "joints": {
              "type": "joint_position",
              "cols": [
                16,
                23
              ]
            },
            "gripper": {
              "type": "joint_position",
              "col": 24,
              "open": -100.0,
              "closed": 100.0
            },
            "ik": {
              "frame": "right_gripper",
              "seed": {
                "group": "joint_pos"
              },
              "q_cols": [
                16,
                23
              ]
            },
            "state": {
              "joints": {
                "group": "joint_pos",
                "offset": 16,
                "n": 7
              },
              "gripper_opening_m": {
                "names": [
                  "right_gripper_opening_m"
                ]
              },
              "ee_pose": {
                "group": "tcp_pose",
                "offset": 7,
                "n": 7
              }
            }
          }
        },
        "base": {
          "type": "joint_position",
          "mode": "pose",
          "cols": {
            "x": 0,
            "y": 1,
            "yaw": 2
          },
          "dt": 0.2,
          "max_v": 0.3,
          "max_w": 0.5,
          "stop_s": 0.4,
          "note": "the base holds absolute world pose targets (base_x, base_y, base_theta); move_robot base goals ramp them; base_theta stays within -pi..pi"
        },
        "notes": "One control step is 0.2 s of simulated time; the episode ends after spec_file max_control_steps steps (the task's horizon). The base is position-controlled in the house's world frame: base_odometry in every result is its world pose. The arms take joint positions; end-effector goals are solved by the service's IK and sent as joint positions. gripper_opening_m is the measured distance between the fingertips."
      }
    },
