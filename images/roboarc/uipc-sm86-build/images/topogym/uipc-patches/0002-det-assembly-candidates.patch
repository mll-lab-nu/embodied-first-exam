+++ b/src/backends/cuda/linear_system/det_scatter.h
@@ -0,0 +1,118 @@
+#pragma once
+// Deterministic keyed accumulation (TopoGym determinism series, patch 0002).
+//
+// Replaces scatter loops of the form `for each contribution e: atomic_add(dst[key(e)], value(e))` (gradient doublets,
+// affine-body diagonal Hessians), whose summation order follows the scheduler. SegmentedAdder sorts the contributions by
+// key with a stable radix sort (so equal keys keep the order in which they were produced), finds the runs of equal keys,
+// and lets one thread per (key, scalar component) sum its run in that order and add the sum to dst once. All index
+// arithmetic is integer; the only float operations are the per-run sums, in a fixed order.
+#include <type_define.h>
+#include <muda/buffer/device_buffer.h>
+#include <cub/device/device_radix_sort.cuh>
+#include <cub/device/device_run_length_encode.cuh>
+#include <cub/device/device_scan.cuh>
+
+namespace uipc::backend::cuda::det
+{
+namespace scatter_detail
+{
+    template <int Unused = 0>
+    __global__ void prepare_keys(int n, const int* keys, int key_shift, int* out_keys, int* out_pos)
+    {
+        int e = blockIdx.x * blockDim.x + threadIdx.x;
+        if(e < n)
+        {
+            out_keys[e] = keys[e] - key_shift;
+            out_pos[e]  = e;
+        }
+    }
+
+    // thread = (run, component): dst[key * dim + c] += sum over the run, in order, of values[pos * dim + c]
+    template <int Unused = 0>
+    __global__ void sum_runs(int          runs,
+                                    int          dim,
+                                    const int*   unique_keys,
+                                    const int*   run_offsets,
+                                    const int*   run_counts,
+                                    const int*   sorted_pos,
+                                    const Float* values,
+                                    Float*       dst,
+                                    const IndexT* skip)
+    {
+        int t = blockIdx.x * blockDim.x + threadIdx.x;
+        if(t >= runs * dim)
+            return;
+        int r   = t / dim;
+        int c   = t - r * dim;
+        int key = unique_keys[r];
+        if(key < 0 || (skip && skip[key]))
+            return;
+        Float acc   = 0;
+        int   begin = run_offsets[r];
+        int   end   = begin + run_counts[r];
+        for(int e = begin; e < end; ++e)
+            acc += values[static_cast<size_t>(sorted_pos[e]) * dim + c];
+        dst[static_cast<size_t>(key) * dim + c] += acc;
+    }
+}  // namespace scatter_detail
+
+class SegmentedAdder
+{
+  public:
+    // For every distinct k = keys[e] - key_shift >= 0 among e < n (skip[k] != 0 drops k):
+    //   dst[k*dim .. k*dim+dim) += sum, in e order, of values[e*dim .. e*dim+dim).
+    // `keys`, `values`, `dst`, `skip` are device pointers; default stream.
+    void add(int n, const int* keys, int key_shift, const Float* values, int dim, Float* dst, const IndexT* skip = nullptr)
+    {
+        using namespace scatter_detail;
+        if(n <= 0)
+            return;
+        constexpr int bd = 256;
+        m_keys.resize(n);
+        m_keys_sorted.resize(n);
+        m_pos.resize(n);
+        m_pos_sorted.resize(n);
+        m_unique.resize(n);
+        m_counts.resize(n);
+        m_offsets.resize(n);
+        m_num_runs.resize(1);
+        prepare_keys<<<(n + bd - 1) / bd, bd>>>(n, keys, key_shift, m_keys.data(), m_pos.data());
+
+        size_t bytes = 0;
+        cub::DeviceRadixSort::SortPairs(nullptr, bytes, m_keys.data(), m_keys_sorted.data(), m_pos.data(),
+                                        m_pos_sorted.data(), n);
+        reserve_temp(bytes);
+        cub::DeviceRadixSort::SortPairs((void*)m_temp.data(), bytes, m_keys.data(), m_keys_sorted.data(), m_pos.data(),
+                                        m_pos_sorted.data(), n);
+
+        bytes = 0;
+        cub::DeviceRunLengthEncode::Encode(nullptr, bytes, m_keys_sorted.data(), m_unique.data(), m_counts.data(),
+                                           m_num_runs.data(), n);
+        reserve_temp(bytes);
+        cub::DeviceRunLengthEncode::Encode((void*)m_temp.data(), bytes, m_keys_sorted.data(), m_unique.data(),
+                                           m_counts.data(), m_num_runs.data(), n);
+        int runs = 0;
+        cudaMemcpy(&runs, m_num_runs.data(), sizeof(int), cudaMemcpyDeviceToHost);
+
+        bytes = 0;
+        cub::DeviceScan::ExclusiveSum(nullptr, bytes, m_counts.data(), m_offsets.data(), runs);
+        reserve_temp(bytes);
+        cub::DeviceScan::ExclusiveSum((void*)m_temp.data(), bytes, m_counts.data(), m_offsets.data(), runs);
+
+        int threads = runs * dim;
+        if(threads > 0)
+            sum_runs<<<(threads + bd - 1) / bd, bd>>>(runs, dim, m_unique.data(), m_offsets.data(), m_counts.data(),
+                                                      m_pos_sorted.data(), values, dst, skip);
+    }
+
+  private:
+    void reserve_temp(size_t bytes)
+    {
+        if(m_temp.size() < bytes)
+            m_temp.resize(bytes);
+    }
+
+    muda::DeviceBuffer<int>       m_keys, m_keys_sorted, m_pos, m_pos_sorted, m_unique, m_counts, m_offsets, m_num_runs;
+    muda::DeviceBuffer<std::byte> m_temp;
+};
+}  // namespace uipc::backend::cuda::det
