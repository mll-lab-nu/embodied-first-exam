# Standard-realtime mode (PROTOCOL §4b): the simulator runs in the `sim` sidecar (the agent cannot open it), on its own clock
# once an episode starts (sim/rcb_realtime.py, the shared eai-standard/2.3 layer, with sim/server.py, this benchmark's
# adapter); the agent only reaches port 8000. No `expose`/`ports` on sim: under Harbor's egress control it shares main's
# network namespace (localhost:8000).
# SAPIEN needs a Vulkan device (the NVIDIA GPU) to build the scene and render the cameras; physics is CPU PhysX. The
# sidecar is TRUSTED: ./sim (the frozen instance, the service, the tooling) is mounted only here, never where agent code runs.
# Crash recovery: compose restarts the service, which resumes the same episode, paused, never a reset.
# Knobs: ${NAME:-default} takes NAME from the shell that runs harbor. The defaults are the task's configuration; results
# under other settings are reported separately.
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
    working_dir: /tmp
    command: python /srv/rcb_realtime.py
    restart: on-failure:6          # N >= 3 (PROTOCOL §4.1); a resume continues the episode, paused
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_TEXTS: /srv/texts.json
      RCB_TOOL: /srv/rcb_pandadyn.py
      RCB_DATA: /data
      RCB_WALL_CLOCK_S: "@@AGENT_TIMEOUT_S@@"   # = task.toml [agent] timeout_sec (reported only: spec budget, meta time_left_s)
      RCB_STARTUP_TIMEOUT_S: "600"
      PYTHONPATH: /srv:/opt/pandadyn
      RCB_SESSION_LOG: ""           # the sidecar's own Session must not write the agent-side interaction log
      RCB_SLOWDOWN: "${RCB_SLOWDOWN:-@@SLOWDOWN@@}"                # S = @@SLOWDOWN@@: the world runs at 1/S of real speed (this family's measured RTF @@RTF@@; PROTOCOL §4b)
      RCB_RESET_BUDGET: "${RCB_RESET_BUDGET:-@@RT_RESETS@@}"        # @@RT_RESETS@@ resets (PROTOCOL §4b default); 0: one episode
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
