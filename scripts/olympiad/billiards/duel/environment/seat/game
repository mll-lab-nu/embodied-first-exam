#!/usr/bin/env python3
"""game — two-player 8-ball (program play). The same calls are plain HTTP + JSON at
http://sim:8000/<your seat>/ (your seat is $SEAT, also in `game spec`).

  game spec                               your seat, table, pockets (ids lb lc lt rb rc rt), cameras, clocks
  game status                             the current state (no images)
  game start                              you are ready; the game begins when both players have started
  game wait [MAX_S]                       block until it is your turn (or the match is over), at most MAX_S s (<= 60)
  game observe [AIM_DEG]                  the table: saves two camera images to /app/output/views/ (top view and a
                                          sighting view behind the cue ball along AIM_DEG; default: towards the centre)
  game shoot AIM_DEG SPEED [SPIN_X SPIN_Y] [cue=X,Y] [call=BALL:POCKET|safety]
                                          play a shot (only on your turn): cue direction (degrees counter-clockwise
                                          from +x), cue stick speed (m/s), tip offset in ball radii (x = right english,
                                          y = follow); cue=X,Y places the cue ball first (ball in hand only);
                                          call=BALL:POCKET (e.g. 3:rc, 8:lt) or call=safety: required on every shot
                                          but the break
  game ready "WHY" "PLAN"                 after each of your shots: your review; the game goes on only then
Every reply includes the state (groups, balls left, whose turn, ball in hand, both clocks) and the shots played since your previous call.
"""
import base64, json, os, sys, tempfile, urllib.error, urllib.request

VIEWS = "/app/output/views"
BASE = os.environ.get("SIM_URL", "http://sim:8000") + "/" + os.environ.get("SEAT", "A")


def call(path, body=None):
    req = urllib.request.Request(BASE + path, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            out = json.load(e)
        except ValueError:
            out = {"error": str(e)}
        out["http_status"] = e.code
        return out


def save(name, b64):
    os.makedirs(VIEWS, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=VIEWS, prefix=name + "_", suffix=".png", delete=False) as f:
        f.write(base64.b64decode(b64))
        return f.name


def show(o):
    for k in ("observation", "next"):
        x = o.get(k)
        if isinstance(x, dict) and "images_png_b64" in x:
            n = x.get("shot_number")
            x["image_files"] = {cam: save(f"shot{n}_{cam}", b) for cam, b in x.pop("images_png_b64").items()}
    print(json.dumps(o, indent=1))


a = sys.argv[1:]
try:
    if a == ["spec"]:
        show(call("/spec"))
    elif a == ["status"]:
        show(call("/status"))
    elif a == ["start"]:
        show(call("/start", {}))
    elif a[:1] == ["wait"] and len(a) in (1, 2):
        show(call("/wait", {"max_s": float(a[1]) if len(a) == 2 else 30.0}))
    elif a[:1] == ["observe"] and len(a) in (1, 2):
        show(call("/observe", {"aim": float(a[1])} if len(a) == 2 else {}))
    elif a[:1] == ["ready"] and len(a) == 3:
        show(call("/ready", {"why": a[1], "plan": a[2]}))
    elif a[:1] == ["shoot"]:
        pos = [x for x in a[1:] if "=" not in x]
        kw = dict(x.split("=", 1) for x in a[1:] if "=" in x)
        if len(pos) not in (2, 4) or set(kw) - {"cue", "call"}:
            sys.exit(__doc__)
        v = [float(x) for x in pos]
        body = {"type": "shoot", "aim_deg": v[0], "speed": v[1]}
        if len(v) == 4:
            body["spin_x"], body["spin_y"] = v[2], v[3]
        if "cue" in kw:
            body["cue_x"], body["cue_y"] = (float(t) for t in kw["cue"].split(","))
        if "call" in kw:
            body["call"] = kw["call"]
        show(call("/act", body))
    else:
        sys.exit(__doc__)
except ValueError:
    sys.exit(__doc__)
