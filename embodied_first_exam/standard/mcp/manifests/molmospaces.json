{
  "manifest": "efe-mcp-manifest/0",
  "suite": "molmospaces",
  "kind": "rcb",
  "robot": "MolmoSpaces robot (per task: a Rainbow Robotics RB-Y1 mobile manipulator, or a Franka FR3 arm with a Robotiq 2F-85 gripper on a fixed base)",
  "frame": {
    "suite": "the simulator's world frame of this house: z up, metres",
    "quat": "wxyz"
  },
  "control": {
    "min_move_s": 0.4,
    "gripper_settle_s": 0.4,
    "settle_s": 0.0,
    "joint_speed": 1.0,
    "tolerance": {
      "pos_m": 0.01,
      "rot_rad": 0.05,
      "joint": 0.03
    }
  },
  "signals": {
    "done": {
      "type": "done"
    }
  },
  "signals_text": "signal done ends the episode at once: the state at that moment is judged (the task has to hold then). Without it the episode ends at the step limit or when your time is up, judged the same way.",
  "base": null,
  "locomotion": null,
  "variants": [
    {
      "match": "molmospaces-navigate-to-*",
      "patch": {
        "robot": "Rainbow Robotics RB-Y1 mobile manipulator: holonomic base, 6-joint torso, two 7-joint arms with parallel grippers, head camera",
        "frame": {
          "base": {
            "pos": {
              "names": [
                "base_x",
                "base_y"
              ]
            },
            "z": 0.0,
            "yaw": {
              "names": [
                "base_theta"
              ]
            }
          },
          "base_text": "the robot base frame: on the floor under the base's centre (base_x, base_y), +X the way the base faces (base_theta), +Y to its left, +Z up; it moves with the base and is re-read at the start of every call"
        },
        "cameras": [
          "head_camera",
          "wrist_camera_l",
          "wrist_camera_r"
        ],
        "default_cameras": [
          "head_camera",
          "wrist_camera_l",
          "wrist_camera_r"
        ],
        "action_cameras": [
          "head_camera"
        ],
        "state_cameras": [
