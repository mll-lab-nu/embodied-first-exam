# Standard mode: the simulator runs in the `sim` sidecar (agent cannot open it); the agent only reaches port 8000.
# No `expose`/`ports` on sim: under Harbor's egress control it shares main's network namespace (localhost:8000).
# Isaac Sim needs an RTX-class GPU even headless (AM-Bench's physics runs on it too). The sidecar runs two Isaac processes: the
# camera-free physics service and the render worker that draws the onboard cameras (rcb_ambench.Renderer). It is TRUSTED:
# its Kit cache is the trusted volume, never mounted where agent code runs (Isaac keeps generated Python there that Kit
# imports); it has no fixed name, so every trial's compose project gets its own (Harbor's teardown deletes it).
# Crash recovery (docs/protocol/standard_mode.md §13): run.sh exits non-zero when the service crashes and compose restarts the
# same container (its /data kept); the service resumes the episode from its journal. RCB_STARTUP_TIMEOUT_S: the startup
# watchdog, at least twice the slowest measured scene build (docs/benchmarks/ambench.md).
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
      - rcb_ambench_cache_trusted:/cache
    working_dir: /tmp
    command: sh /srv/run.sh
    restart: on-failure:6
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_TOOL: /srv/rcb_ambench.py
      RCB_DATA: /data
      RCB_RENDER_LOG: /data/render_worker.log   # the render worker's own log: its messages are not the physics process's
      RCB_WALL_CLOCK_S: "@@AGENT_TIMEOUT_S@@"
      RCB_STARTUP_TIMEOUT_S: "2400"
      RCB_COLLECT_TIMEOUT_S: "4800"   # = task.toml's [[verifier.collect]] timeout_sec (finalize.sh's HOOK_BUDGET_S)
      PYTHONPATH: /srv
      RCB_SESSION_LOG: ""           # the sidecar's own Session must not write the agent-side interaction log
    shm_size: "8gb"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
volumes:
  rcb_ambench_cache_trusted:
