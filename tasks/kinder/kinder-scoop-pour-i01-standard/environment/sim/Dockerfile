COPY --from=ghcr.io/mll-lab-nu/efe:kinder-files-0.7.0@sha256:57c2433e95239e521948d1067f65f5f38fea6d0d724b541c98e20ff7790f63ba \
     /privileged/environment/rcb_kinder.py \
     /sim/server.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:standard-files-0.8.0@sha256:497a2b864b3a1aaf1f60206dc14f08a0f99960037f0e54be3d4bc2e39f5adba4 /sidecar/rcb_service.py /srv/rcb_service.py
