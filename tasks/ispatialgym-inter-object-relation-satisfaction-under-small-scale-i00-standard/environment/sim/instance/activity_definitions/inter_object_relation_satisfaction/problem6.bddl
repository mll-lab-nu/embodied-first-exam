(define (problem inter_object_relation_satisfaction-6)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-under_small_scale-beer_glass-coaster-booth)

    ; IORS - under (small-scale). Both objects on the support; the manipulated target (glass, teacup, fries, bottle) is set
    ; down centred on the partner (coaster, saucer, platter, tray) so that the PARTNER ends under the target. Argument order
    ; is therefore (under partner target). Both poses measured.

    (:objects
        beer_glass.n.01_1 - beer_glass.n.01
        coaster.n.03_1 - coaster.n.03
        booth.n.01_1 - booth.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop beer_glass.n.01_1 booth.n.01_1)
        (ontop coaster.n.03_1 booth.n.01_1)
        (not (under coaster.n.03_1 beer_glass.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (under ?coaster.n.03_1 ?beer_glass.n.01_1)
            (not (grasped ?agent.n.01_1 ?beer_glass.n.01_1))
            (not (grasped ?agent.n.01_1 ?coaster.n.03_1))
            (pose_settled ?beer_glass.n.01_1)
            (pose_settled ?coaster.n.03_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?beer_glass.n.01_1)
        (pose_reached ?coaster.n.03_1)
    )
)
