COPY --from=ghcr.io/mll-lab-nu/efe:robocasa-files-0.8.0@sha256:8c68a8d3b23102075be994147efc623c0ee493d178dade743699782b4bcb1a80 \
     /sim/finalize.sh \
     /sim/server_casa.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:standard-files-0.8.0@sha256:a99b04e29e96564b62a2c335b191405d8a94785d6efea2bb5765acbefde92383 /rcb1.py /srv/rcb1.py
