#!/usr/bin/env python3
"""game — the client of the tennis duel service for this seat (wall-clock real time, program play, two players).

The world runs on its own at 1/SLOWDOWN of real speed (`game spec` timing.slowdown: 1 s of game time takes SLOWDOWN s
of real time). It does not wait for you: your thinking, your tool calls and the network all take real time while it
runs. One act or move at a time (a second one before the first has returned is refused).

  game start                            ready to start: the world is frozen until both players have started; from
                                        then on it runs by itself
  game observe                          the newest camera frames (saved to /app/output/views/obs_<n>_*.png: open
                                        it), what you heard (bounces), the game time, your robot and its command;
                                        call it whenever you want
  game act T PX PY PZ NX NY NZ VX VY VZ [BX BY]
                                        new command: the racket state at contact T s (game time, <= 5) FROM WHEN
                                        THE COMMAND TAKES EFFECT (`game spec` timing.act_lead_steps control steps
                                        after the step at which it is accepted, the next 10 ms step after it arrives;
                                        the reply says when): head centre, string-face normal, head velocity, and optionally
                                        the base position at contact (default: the forehand stance, contact xy -
                                        (0.62, 0.30)). It replaces the stroke under way (corrections ok)
  game act none                         cancel the command: the arm returns to the ready pose (next step)
  game move BX BY                       the base's rest position: where the base goes whenever no stroke is under
                                        way (back home after every point; next step); counts as an act
  game wait DT                          block until DT more seconds of game time have passed (0 < DT <= 1.0)
  game ready "WHY" "PLAN"               after each point: your review (in time, else you forfeit); the world stays
                                        frozen until both players have sent theirs
  game status | game spec
"""
import base64, json, os, sys, tempfile, urllib.error, urllib.request

VIEWS = "/app/output/views"


def base():
    for b in [os.environ.get("SIM_URL"), "http://sim:8000", "http://127.0.0.1:8000"]:
        if not b:
            continue
        b = b.rstrip("/") + "/" + os.environ.get("SEAT", "A")
        try:
            urllib.request.urlopen(b + "/spec", timeout=3)
            return b
        except urllib.error.HTTPError:
            return b
        except Exception:
            continue
    sys.exit("game service unreachable")


def call(path, body=None):
    req = urllib.request.Request(BASE + path, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        return json.load(urllib.request.urlopen(req, timeout=900))
    except urllib.error.HTTPError as e:
        return json.load(e)


def show(o):
    ob = o.get("observation") if isinstance(o, dict) else None
    if isinstance(ob, dict) and "image_png_b64" in ob:
        os.makedirs(VIEWS, exist_ok=True)
        # Parallel observations must never overwrite the image another tool is opening.
        with tempfile.NamedTemporaryFile(dir=VIEWS, prefix=f"obs_{ob.get('obs_id', 0)}_",
                                         suffix=".png", delete=False) as f:
            f.write(base64.b64decode(ob.pop("image_png_b64")))
            p = f.name
        ob["image_file"] = p
    print(json.dumps(o, indent=1))


BASE = base()
a = sys.argv[1:]
if a[:1] == ["start"] and len(a) == 1:
    show(call("/start", {}))
elif a[:1] == ["observe"] and len(a) == 1:
    show(call("/observe", {}))
elif a[:1] == ["act"] and a[1:] == ["none"]:
    show(call("/act", {"type": "none"}))
elif a[:1] == ["act"] and len(a) in (11, 13):
    try:
        v = [float(x) for x in a[1:]]
    except ValueError:
        sys.exit(__doc__)
    body = {"type": "act", "t": v[0], "pos": v[1:4], "normal": v[4:7], "vel": v[7:10]}
    if len(v) == 12:
        body["base"] = v[10:12]
    show(call("/act", body))
elif a[:1] == ["move"] and len(a) == 3:
    try:
        v = [float(x) for x in a[1:3]]
    except ValueError:
        sys.exit(__doc__)
    show(call("/act", {"type": "move", "base": v}))
elif a[:1] == ["wait"] and len(a) == 2:
    show(call("/wait", {"dt": a[1]}))
elif a[:1] == ["ready"] and len(a) == 3:
    show(call("/ready", {"why": a[1], "plan": a[2]}))
elif a[:1] == ["status"]:
    show(call("/status"))
elif a[:1] == ["spec"]:
    show(call("/spec"))
else:
    print(__doc__)
