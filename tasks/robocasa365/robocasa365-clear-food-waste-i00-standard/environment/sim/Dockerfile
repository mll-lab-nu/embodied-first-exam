COPY . /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:robocasa365-sim-files-0.1.1@sha256:ffacc587b362ea68d9cf58620e6a5a262d96dc17fe586628aee19a14bfa00228 \
     /privileged/environment/casa_tool.py \
     /sim/finalize.sh \
     /sim/server_casa.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:standard-sim-files-0.1.1@sha256:d9a4e130a67056d0fb47594562ac303b2f000c5f48fbe5ec235593bef0f3543f /rcb1.py /srv/rcb1.py
