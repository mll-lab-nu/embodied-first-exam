@@ -228,31 +251,58 @@ FastSegmentalReduce<BlockSize, WarpSize>& FastSegmentalReduce<BlockSize, WarpSiz
                     }
                 }
 
-                flags.flags = WarpReduceInt(index_storage[warp_id])
-                                  .HeadSegmentedReduce(flags.flags, flags.is_head, op);
-
+                // TopoGym determinism series (patch 0003): head flags straight from the keys; the warp reduces each
+                // segment piece in its fixed shuffle order and the piece's head assigns it. The second pass below then
+                // overwrites every segment that crosses a warp boundary with the in-order reduction of all its
+                // elements (was: the pieces of such segments were atomically added, in scheduler order; and the write
+                // rule read the reduced flags word, whose fourth byte is never initialised).
+                const int head = flags.is_head;
                 for(int j = 0; j < M; j++)
                 {
                     for(int k = 0; k < N; k++)
                     {
                         value(j, k) =
-                            WarpReduceT(t_storage[warp_id])
-                                .HeadSegmentedReduce(value(j, k), flags.is_head, op);
+                            WarpReduceT(t_storage[warp_id]).HeadSegmentedReduce(value(j, k), head, op);
                     }
                 }
 
-                if(flags.is_head && flags.is_valid)
+                if(head && flags.is_valid)
                 {
-                    if(flags.is_cross_warp)
-                    {
-                        auto& out_value = out(i);
-                        eigen::atomic_add(out_value, value);
-                    }
-                    else
