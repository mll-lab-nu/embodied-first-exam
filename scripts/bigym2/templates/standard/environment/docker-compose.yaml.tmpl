# Standard mode: the simulator runs in the `sim` sidecar (the agent cannot open it); the agent only reaches port 8000.
# No `expose`/`ports` on sim: under Harbor's egress control it shares main's network namespace (localhost:8000).
# GPU on sim: physics and the whole-body controller run on the CPU, but upstream's env renders the robot's three cameras
# every control step, and every image the agent asks for is rendered here (EGL). `graphics` mounts the EGL ICD.
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
    command: @@SIM_COMMAND@@
    restart: on-failure:6                               # a crash resumes the same episode, never a reset (rcb_service.py)
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_TASK_TEXT: @@TASK_TEXT_YAML@@
      RCB_EPISODE: @@EPISODE_TEXT_YAML@@
      RCB_WALL_CLOCK_S: "3600"
      # Knobs: ${NAME:-default} takes NAME from the shell that runs harbor. The defaults are the standard
      # configuration; results under other settings are reported separately.
@@SLOWDOWN_LINE@@      RCB_RESET_BUDGET: "${RCB_RESET_BUDGET:-@@RESET_BUDGET@@}"        # @@RESET_COMMENT@@
      RCB_IMAGE_HW: "${RCB_IMAGE_HW:-84}"               # the side of each onboard camera's square image, pixels (84: upstream's)
      RCB_SESSION_LOG: ""
      NVIDIA_DRIVER_CAPABILITIES: compute,graphics,utility
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
