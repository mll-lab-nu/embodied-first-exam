+// TopoGym determinism series, patch 0002: every (i, id) pair occurs once per query, so sorting by the packed key gives
+// one canonical candidate order; everything downstream (contact energies, gradients, Hessian triplets, compaction by
+// cub::DeviceSelect) follows the candidate index.
+void AtomicCountingLBVH::canonical_sort(QueryBuffer& qbuffer)
+{
+    using namespace muda;
+    int n = static_cast<int>(qbuffer.m_size);
+    if(n <= 1)
+        return;
+    cudaStream_t s = m_stream;
+    m_sort_keys_in.resize(n);
+    m_sort_keys_out.resize(n);
+    ParallelFor(0, s)
+        .file_line(__FILE__, __LINE__)
+        .apply(n,
+               [pairs = qbuffer.m_pairs.viewer().name("pairs"),
+                keys  = m_sort_keys_in.viewer().name("keys")] __device__(int k) mutable
+               {
+                   const Vector2i& p = pairs(k);
+                   keys(k) = (static_cast<unsigned long long>(static_cast<unsigned int>(p(0))) << 32)
+                             | static_cast<unsigned int>(p(1));
+               });
+    size_t bytes = 0;
+    cub::DeviceRadixSort::SortKeys(nullptr, bytes, m_sort_keys_in.data(), m_sort_keys_out.data(), n, 0, 64, s);
+    if(m_sort_temp.size() < bytes)
+        m_sort_temp.resize(bytes);
+    cub::DeviceRadixSort::SortKeys((void*)m_sort_temp.data(), bytes, m_sort_keys_in.data(), m_sort_keys_out.data(), n,
+                                   0, 64, s);
+    ParallelFor(0, s)
+        .file_line(__FILE__, __LINE__)
+        .apply(n,
+               [pairs = qbuffer.m_pairs.viewer().name("pairs"),
+                keys  = m_sort_keys_out.viewer().name("keys")] __device__(int k) mutable
+               {
+                   unsigned long long v = keys(k);
+                   pairs(k) = Vector2i(static_cast<int>(v >> 32), static_cast<int>(v & 0xffffffffull));
+               });
+}
 }  // namespace uipc::backend::cuda
