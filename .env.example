# Harbor forwards these into the agent container. Copy to .env (gitignored) or export them.
ANTHROPIC_API_KEY=            # or CLAUDE_CODE_OAUTH_TOKEN=... with CLAUDE_FORCE_OAUTH=1
OPENAI_API_KEY=               # or CODEX_FORCE_AUTH_JSON=1 to reuse ~/.codex/auth.json (ChatGPT login)
OPENROUTER_API_KEY=           # optional: one key for both Codex and Claude Code through OpenRouter
