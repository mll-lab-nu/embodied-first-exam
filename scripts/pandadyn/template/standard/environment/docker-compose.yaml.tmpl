# Standard mode: the simulator runs in the `sim` sidecar (the agent cannot open it); between the agent's calls the world is
# frozen (sim/server.py, this benchmark's adapter -- the code of its standard-realtime twins' -- served by
# sim/rcb_service.py, the shared eai-standard/2.1 layer); the agent only reaches port 8000. No `expose`/`ports` on sim:
# under Harbor's egress control it shares main's network namespace (localhost:8000).
# SAPIEN needs a Vulkan device (the NVIDIA GPU) to build the scene and render the cameras; physics is CPU PhysX. The
# sidecar is TRUSTED: ./sim (the frozen instance, the service, the tooling) is mounted only here, never where agent code runs.
# Crash recovery: compose restarts the service, which resumes the same episode from its journal, never a reset.
# Knobs: ${NAME:-default} takes NAME from the shell that runs harbor. The defaults are the task's configuration; results
# under other settings are reported separately.
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
    working_dir: /tmp
    command: python /srv/server.py
    restart: on-failure:6          # a crash resumes the same episode, never a reset (rcb_service.py)
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_TEXTS: /srv/texts.json
      RCB_DATA: /data
      RCB_WALL_CLOCK_S: "@@AGENT_TIMEOUT_S@@"   # = task.toml [agent] timeout_sec (reported only: spec budget, meta time_left_s)
      RCB_STARTUP_TIMEOUT_S: "600"
      PYTHONPATH: /srv:/opt/pandadyn
      RCB_SESSION_LOG: ""           # the sidecar's own Session must not write the agent-side interaction log
      RCB_RESET_BUDGET: "${RCB_RESET_BUDGET:-@@RESETS@@}"        # @@RESETS@@ resets, as in the standard-realtime twins (docs/benchmarks/pandadyn.md, "Reset budget"); 0: one episode
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
