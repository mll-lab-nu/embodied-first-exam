# Environment files (same public example exception as robot_coding_bench)
.env
.env.*
!.env.example
.secrets/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Run outputs & recordings (videos, frames, datasets, logs)
*.log
/outputs/
/MUJOCO_LOG.TXT
runs/
task_rollouts/
# Retired generated Harbor tasks; current tasks/ stays versioned.
/harbor_tasks/
# Full local proof evidence; small catalogs/manifests/docs remain versionable.
/solvability_proof/*/*/evidence/
bash_scripts/recordings/

# TetGen scratch files (dumped into repo root during soft-body meshing)
tetgen-tmpfile*

# Weekly report decks (per-week folders with copied demo videos; shared by zip, not git)
topogym_weekly_report/

# Archived deliverables remain local; source/config/docs in legacy are versioned.
/legacy/runs/
/legacy/reports/
/legacy/harbor_tasks/
# Outputs preserved by the 2026-09-29 cleanup; archived source/docs stay versionable.
/legacy/cleanup_20260929/harbor_tasks/
/legacy/cleanup_20260929/reports/
/legacy/cleanup_20260929/outputs/
/legacy/cleanup_20260929/MUJOCO_LOG.TXT
# Full local hash inventory; the small archive manifest remains versionable.
/legacy/cleanup_20260929/files.jsonl

# Published demos, task results, source/config/docs remain versionable.
!/demos/**/*.mp4

# Harbor runs (robot_coding_bench layout): job outputs and local credentials stay out of git
/jobs/
/exps/
