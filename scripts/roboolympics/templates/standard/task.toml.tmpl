schema_version = "1.3"
artifacts = [
  { source = "/data/final.json", service = "sim" },
  { source = "/data/episode.jsonl", service = "sim" },
  { source = "/data/trajectory.npz", service = "sim" },
  { source = "/data/trajectory_live.f64", service = "sim" },
  { source = "/data/referee.json", service = "sim" },
  { source = "/data/replay.mp4", service = "sim" },
  { source = "/data/replay.last.png", service = "sim" },
  { source = "/data/calls/", service = "sim" },
  { source = "/data/startups.jsonl", service = "sim" },
  { source = "/data/crash.log", service = "sim" },
  "/app/output/",
]

[task]
name = "robot-coding-bench/@@STD@@"
description = "STANDARD MODE (robot as a service, eai-standard/2.1): RoboOlympics @@FAMILY@@ on the same frozen instance as @@PRIV@@. @@SENTENCE_TOML@@ The agent only gets a client: the robot's two head cameras (depth on one), its joint sensors and IMUs, the venue's fixed camera, and action chunks (walking, running, joint targets, Unitree LowCmd, the hands' grip). @@RESET_BUDGET@@ resets, the last attempt graded; no object state, no referee state during an attempt. The sim service records the attempt and grades it live with the family's referee (no grading replay)."
authors = [{ name = "Kangrui Wang" }]
keywords = ["robotics", "roboolympics", "sports", "mujoco", "@@ROBOT_KW@@", "humanoid", "standard-mode", "trajectory", "@@FAMILY@@"]

[metadata]
author_name = "Kangrui Wang"
task_type = "trajectory"
simulator = "mujoco"
robot = "@@ROBOT_ID@@"
family = "@@FAMILY_ID@@"
category = "@@CATEGORY@@"
mode = "standard"
network = "open"                 # the agent's egress (docs/protocol/README.md §2): open, the author's choice
protocol = "eai-standard/2.1"
instance_seed = @@SEED@@
reset_budget = @@RESET_BUDGET@@
expert_time_estimate_hours = @@EXPERT_HOURS_STD@@
oracle = "@@ORACLE@@"
oracle_evidence = "@@ORACLE_EVIDENCE_STD@@"

[verifier]
timeout_sec = 900.0
environment_mode = "separate"
network_mode = "no-network"

# The agent's time is up: stop whatever it left running in its container. Harbor stops that container only after
# collecting from it (~12 s), and a script still running there would keep driving the robot past the deadline.
[[verifier.collect]]
service = "main"
command = "kill -9 -1 2>/dev/null; exit 0"
timeout_sec = 30

# Then the episode ends: SIGUSR1 to the service (re-sent every 30 s, in case it was restarting), which grades the live
# episode (no grading replay, board 0151). The loops run on the clock, inside timeout_sec: the verdict ("finalized":
# true, written before any video is rendered) may take until 840 s (the end waits through a crash-recovery resume);
# then the hook waits for the video, one render pass from the trajectory ("video_pending"), until 870 s -- a video that
# is not ready by then is lost, the verdict is not.
[[verifier.collect]]
service = "sim"
command = "t0=$(date +%s); while [ ! -f /data/server.pid ] && [ $(( $(date +%s) - t0 )) -lt 120 ]; do sleep 2; done; i=0; while [ $(( $(date +%s) - t0 )) -lt 840 ] && ! grep -q '\"finalized\": true' /data/final.json 2>/dev/null; do [ $((i % 15)) -eq 0 ] && kill -USR1 $(cat /data/server.pid 2>/dev/null) 2>/dev/null; i=$((i + 1)); sleep 2; done; while [ $(( $(date +%s) - t0 )) -lt 870 ] && grep -q '\"video_pending\": true' /data/final.json 2>/dev/null; do sleep 2; done; cat /data/final.json"
timeout_sec = 900

[agent]
timeout_sec = @@AGENT_TIMEOUT@@.0
# Egress: open (Harbor's default), as `[metadata] network` declares. RoboOlympics lets the agent search for and download
# public tools, robot models and pretrained controllers (owner, 2026-10-11; docs/benchmarks/roboolympics.md). The agent's
# container holds no simulator, no referee and no instance.

[environment]
build_timeout_sec = 1800.0
cpus = 4
memory_mb = 10240

[verifier.environment]
build_timeout_sec = 600.0
