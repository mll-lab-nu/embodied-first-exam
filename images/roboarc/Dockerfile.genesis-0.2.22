# RoboTangle base image (eai-robotangle; formerly rcb-topogym): images/topogym/Dockerfile of the release commit in
# scripts/robotangle/release.json, unchanged except that UIPC_WHEEL defaults to prebuilt (the task bindings name the audited
# libuipc wheel) and the robot_coding_bench additions at the end (the frozen instances, the sm86 libuipc build, the check of
# both libuipc wheels). Its build context is prepared by
# scripts/robotangle/fetch_image_context.sh in images/robotangle/context/ (images/robotangle/BUILD_CONTEXT) from the private
# HF dataset pinned in scripts/robotangle/assets.json (internal; only the built image is public). Build instructions:
# images/robotangle/README.md.
# rcb-topogym: Genesis 1.2.1 / Nyx with cu128 torch and original pyuipc 0.0.25 materials (libuipc 292c98c3 plus the
# determinism patches in images/topogym/uipc-patches: summation order fixed, physics unchanged).
# Infrastructure only, no benchmark code (docs/protocol/README.md §1): the task tooling (rcb_topogym.py) comes with each task,
# and prune.py removes everything that could hold a reference solution. Tag = images/topogym/VERSION + CUDA profile; build: scripts/build_images.sh
# topogym (from the repository root, which is the build context; .dockerignore keeps it small).
# UIPC_WHEEL=build compiles libuipc (stages uipc-compile, uipc-build); UIPC_WHEEL=prebuilt installs the audited wheel and
# its uipc-build.json from images/topogym/uipc-prebuilt/ instead (helper release trees: nvcc output is not bit-reproducible,
# and the task packages bind the hash of that uipc-build.json).
ARG UIPC_WHEEL=prebuilt
ARG UIPC_BUILDER=sameli/manylinux_2_34_x86_64_cuda_12.8@sha256:0b99ea5d0e32f5ad49b02de2663520f17a8dafc8739365cd7463a82ed3f0590a
FROM ${UIPC_BUILDER} AS uipc-compile
ENV PATH=/opt/python/cp311-cp311/bin:$PATH
# CUDA is already pinned in the builder; generic tools need only OS repos.
# Avoid unrelated NVIDIA repo metadata failures (e.g. stale repodata URLs).
RUN yum --disablerepo='cuda*' install -y git curl zip unzip tar gzip
COPY requirements/uipc-build.lock /recipe/uipc-build.lock
RUN python -m pip install --require-hashes -r /recipe/uipc-build.lock
COPY images/topogym/build_uipc.sh images/topogym/verify_uipc_wheel.py /recipe/
# Determinism source patches for libuipc (applied and hash-checked by verify_uipc_wheel.py prepare; listed in the config).
COPY images/topogym/uipc-patches/ /recipe/uipc-patches/
ARG UIPC_CONFIG=uipc-build.json
COPY images/topogym/${UIPC_CONFIG} /recipe/uipc-build.json
RUN bash /recipe/build_uipc.sh prepare
# The compile parallelism (build_uipc.sh: CMAKE_BUILD_PARALLEL_LEVEL): default 3 = uipc-build.json build_policy.compile_jobs;
# a host with more memory may pass more (lab: --build-arg UIPC_BUILD_JOBS=16).
ARG UIPC_BUILD_JOBS=3
RUN --mount=type=cache,target=/root/.cache/vcpkg \
    --mount=type=cache,target=/build/vcpkg/downloads \
    --mount=type=cache,id=topogym-uipc-objects-${UIPC_CONFIG},target=/build/uipc-build,sharing=locked \
    bash /recipe/build_uipc.sh compile
FROM uipc-compile AS uipc-build
# Keep packaging independent of the expensive compiler stage.
COPY images/topogym/build_uipc.sh images/topogym/verify_uipc_wheel.py /recipe/
ARG UIPC_CONFIG=uipc-build.json
COPY images/topogym/${UIPC_CONFIG} /recipe/uipc-build.json
RUN bash /recipe/build_uipc.sh audit

FROM scratch AS uipc-prebuilt
COPY images/topogym/uipc-prebuilt/ /out/wheels/

FROM uipc-${UIPC_WHEEL} AS uipc-wheels

FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3 AS runtime-deps
ARG CUDA_FLAVOR=cu128
ENV TOPOGYM_CUDA_FLAVOR=${CUDA_FLAVOR}
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOPOGYM_VISUAL_ASSET_ROOT=/opt/topogym-visuals TOPOGYM_ASSET_ROOT=/opt/topogym-assets \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=all
# libopengl0: pymeshlab's filter plugins need libOpenGL.so.0; without it Genesis's PBD remesh (blanket_flatten) fails with
# "MeshSet has no attribute meshing_isotropic_explicit_remeshing" (found 2026-09-30).
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl ca-certificates git build-essential ffmpeg libegl1 libgl1 libopengl0 libglib2.0-0 \
    libx11-6 libxext6 libxrender1 libvulkan1 vulkan-tools libgomp1 ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.30
ARG RUNTIME_LOCK=difficulty-eval-runtime.lock
COPY requirements/${RUNTIME_LOCK} /opt/requirements/runtime.lock
COPY images/topogym/verify_uipc_wheel.py /opt/verify_uipc_wheel.py
RUN python /opt/verify_uipc_wheel.py dependencies /opt/requirements/runtime.lock

FROM runtime-deps AS runtime
COPY --from=uipc-wheels /out/wheels/ /opt/uipc-wheel/
COPY images/topogym/check_gpu_stack.py /opt/check_gpu_stack.py
RUN python /opt/verify_uipc_wheel.py install /opt/uipc-wheel \
    && cp /opt/uipc-wheel/uipc-build.json /opt/uipc-build.json \
    && rm -rf /opt/uipc-wheel
# Resolve pip-provided CUDA libraries without relying on torch import order.
RUN python -c 'import site; from pathlib import Path; paths=sorted({str(p) for s in site.getsitepackages() for p in (Path(s)/"nvidia").rglob("lib") if p.is_dir()}); assert paths; Path("/etc/ld.so.conf.d/topogym-cuda.conf").write_text("\n".join(paths)+"\n")' \
    && ldconfig \
    && python /opt/check_gpu_stack.py --link-only
COPY assets/robots/ /opt/topogym-assets/robots/
RUN chmod -R a+rX /opt/topogym-assets
COPY scripts/prepare_nyx_studio.py /opt/prepare_nyx_studio.py
RUN python /opt/prepare_nyx_studio.py
# Genesis CPU rigid-solver patch for fiber_bundling's articulated bundle (genesis-1.2.1-cpu-tree.patch: tree-sparse mass
# matrix factor, bit-exact; children-first skyline order inside entities above 64 DOFs). Both files are checked before and
# after, so another Genesis wheel fails the build instead of being patched blindly.
COPY images/topogym/genesis-1.2.1-cpu-tree.patch /opt/genesis-cpu-tree.patch
RUN cd "$(python -c 'import importlib.util, pathlib; print(pathlib.Path(importlib.util.find_spec("genesis").origin).parent)')" \
    && printf '%s  %s\n' 5529eee0c837eb08285e8bf08c2843f3b64c7e2760d2e5cdfb181196089a8f5e engine/solvers/rigid/abd/forward_dynamics.py \
        46ad0a691de50b65ecdc2248430b5df320dd396f6d0a8a2d68c04451063c7103 engine/solvers/rigid/constraint/solver.py | sha256sum -c - \
    && patch -p1 --no-backup-if-mismatch < /opt/genesis-cpu-tree.patch \
    && printf '%s  %s\n' 97aaa3a68a855b18cc888a5b525355e2f4cd340bd46822990a52e4a1dd663f06 engine/solvers/rigid/abd/forward_dynamics.py \
        f23f3eece37f9b9a58f8acfb4a058c2c853059c6290d39922d68c6f7c12cdfd9 engine/solvers/rigid/constraint/solver.py | sha256sum -c - \
    && python -m compileall -q engine/solvers/rigid/abd/forward_dynamics.py engine/solvers/rigid/constraint/solver.py \
    && rm /opt/genesis-cpu-tree.patch
COPY topogym/ /opt/topogym/topogym/
COPY images/topogym/prune.py /opt/prune.py
RUN python /opt/prune.py /opt/topogym && rm /opt/prune.py && chmod -R a+rX /opt/topogym
# Trusted limited sidecars run as the invoking UID and write artifacts here.
RUN mkdir -p /data && chmod 1777 /data
# One cache directory for every user (agents and verifiers run as root, limited sidecars as the invoking UID): Genesis'
# and Quadrants' compiled kernels, topogym's asset cache and the NVIDIA shader cache follow XDG_CACHE_HOME, the CUDA JIT
# cache CUDA_CACHE_PATH. images/topogym/warm_cache.sh fills it on a GPU host and commits the result as the published tag,
# so a Session build reuses the compiled kernels instead of compiling them again (cold 183 s -> warm 40 s, 2026-10-02).
ENV XDG_CACHE_HOME=/opt/rcb-cache CUDA_CACHE_PATH=/opt/rcb-cache/nv/ComputeCache
RUN mkdir -p /opt/rcb-cache && chmod 1777 /opt/rcb-cache
ENV PYTHONPATH=/opt/topogym TOPOGYM_SOURCE=/opt/topogym/SOURCE.json
# robot_coding_bench: every task's frozen instance (instance.json + instance_assets/), from the private HF dataset
# eai-v2-internal/robotangle-assets at the revision in scripts/robotangle/assets.json (fetch_image_context.sh checks every
# sha256). A task directory keeps only runtime_binding.json; stage_instance.py copies the task's instance next to it
# and checks it against that binding (privileged: environment/ and tests/ Dockerfiles; standard: the sim's entrypoint).
COPY instances/ /opt/robotangle/instances/
COPY stage_instance.py /opt/robotangle/stage_instance.py
RUN chmod -R a+rX /opt/robotangle
# robot_coding_bench: the NVIDIA Vulkan ICD and EGL vendor files, as in images/robopaint/. The tasks pass one GPU with a
# compose device reservation and no `runtime: nvidia`; NVIDIA_DRIVER_CAPABILITIES=all makes the container toolkit mount the
# driver's graphics libraries, and these files point the Vulkan and EGL loaders at them (Nyx renders through Vulkan).
RUN mkdir -p /usr/share/vulkan/icd.d /usr/share/glvnd/egl_vendor.d && \
    printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.0"}}\n' > /usr/share/vulkan/icd.d/nvidia_icd.json && \
    printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
# The container toolkit's CDI mode also mounts the host's ICD json (/etc/vulkan/icd.d), which would list the GPU twice.
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
# robot_coding_bench: the sm86 libuipc build, in its own prefix /opt/uipc_sm86 (the audited wheel above stays as it is). The
# same recipe as the audited wheel (images/topogym/uipc-build.json, build_uipc.sh, the determinism patches, nvcc 12.8) with
# the architectures 86-real;86-virtual (images/robotangle/uipc-sm86-build), and the same pyuipc version and source commit,
# which the frozen IPC settled states hold. The task tooling chooses the build at Session start, before uipc is imported:
# compute capability 8.9 or 12.x keeps the audited wheel, any other GPU gets /opt/uipc_sm86/site-packages first on sys.path
# (rcb_topogym.py select_uipc_build; scripts/robotangle/release.json uipc_builds).
RUN --mount=type=bind,source=uipc-sm86,target=/tmp/uipc-sm86 \
    --mount=type=bind,source=install_uipc_prefix.py,target=/tmp/install_uipc_prefix.py \
    python /tmp/install_uipc_prefix.py /tmp/uipc-sm86 /opt/uipc_sm86 && chmod -R a+rX /opt/uipc_sm86
WORKDIR /app

# robot_coding_bench: both libuipc wheels checked against their uipc-build.json in the recipe's builder image (cuobjdump of
# nvcc 12.8): wheel, version and CUDA backend hashes, the native kernels and PTX each record lists, its required SASS and the
# PTX of every `-virtual` architecture (verify_uipc_wheel.py check). The image keeps the result in /opt/uipc-check.json.
FROM ${UIPC_BUILDER} AS uipc-check
COPY --from=uipc-wheels /out/wheels/ /check/audited/
COPY uipc-sm86/ /check/sm86/
COPY verify_uipc_wheel.py /check/verify_uipc_wheel.py
RUN /opt/python/cp311-cp311/bin/python /check/verify_uipc_wheel.py check /check/audited /check/sm86 > /check/uipc-check.json

FROM runtime AS final
COPY --from=uipc-check /check/uipc-check.json /opt/uipc-check.json
