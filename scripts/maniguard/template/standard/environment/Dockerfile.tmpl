# Standard mode: the agent container has NO simulator and no ManiGuard code, only Python and the client. The base image and
# the pip pins are the shared eai-standard client (scripts/eai_standard/client.env, client-requirements.txt).
FROM @@CLIENT_IMAGE@@
COPY client-requirements.txt /tmp/client-requirements.txt
RUN pip install --no-cache-dir -r /tmp/client-requirements.txt
COPY rcb_client.py rcb1.py /opt/tools/
ENV PYTHONPATH=/opt/tools
RUN mkdir -p /app/output
WORKDIR /app
