+
+// ---- DetSymSpmv (TopoGym determinism series, patch 0001; see det_spmv.h) ---------------------------------------------
+namespace det_spmv_detail
+{
+__global__ void count_entries(int T, const int* ri, const int* ci, int* counts)
+{
+    int t = blockIdx.x * blockDim.x + threadIdx.x;
+    if(t < T)
+        counts[t] = (ri[t] == ci[t]) ? 1 : 2;
+    else if(t == T)
+        counts[t] = 0;
+}
+
+__global__ void fill_entries(int T, const int* ri, const int* ci, const int* offsets, unsigned long long* keys, int* vals)
+{
+    int t = blockIdx.x * blockDim.x + threadIdx.x;
+    if(t >= T)
+        return;
+    unsigned long long i = static_cast<unsigned int>(ri[t]);
+    unsigned long long j = static_cast<unsigned int>(ci[t]);
+    int                o = offsets[t];
+    keys[o]              = (i << 32) | j;
+    vals[o]              = 2 * t;
+    if(i != j)
+    {
+        keys[o + 1] = (j << 32) | i;
+        vals[o + 1] = 2 * t + 1;
+    }
+}
+
+__global__ void count_rows(int m, const unsigned long long* keys, int* row_counts)
+{
+    int e = blockIdx.x * blockDim.x + threadIdx.x;
+    if(e < m)
+        atomicAdd(&row_counts[keys[e] >> 32], 1);  // integer counts: the result does not depend on the order
+}
+
+__global__ void pack_csr(int m, const int* vals, const int* ri, const int* ci, const Matrix3x3* blocks,
+                         Matrix3x3* csr_blocks, int* csr_cols)
+{
+    int e = blockIdx.x * blockDim.x + threadIdx.x;
+    if(e >= m)
+        return;
+    int v = vals[e];
+    int t = v >> 1;
+    if(v & 1)
+    {
+        csr_blocks[e] = blocks[t].transpose();
+        csr_cols[e]   = ri[t];
+    }
+    else
+    {
+        csr_blocks[e] = blocks[t];
+        csr_cols[e]   = ci[t];
+    }
+}
+
+// Rows are split once per assembly (integer only) into short rows (at most kLongRowMin - 1 blocks) and long rows. A
+// short row gets LS lanes (lane l sums the row's blocks l, l + LS, ... in order, a fixed xor butterfly combines the
+// lanes); a long row gets a whole thread block (a fixed cub::BlockReduce tree combines the threads). Both groups loop over their row list with a fixed grid stride (grid sizes depend
+// only on the row counts), every lane of a warp takes part in every shuffle. With a dot product, each lane group sums
+// its rows' dots in loop order, the thread block sums its groups in group order into partial[block], and the last
+// thread block to finish (integer atomic counter) sums the partials in index order. Every partial sum has a fixed place
+// in a fixed order, so y and the dot do not depend on the scheduler.
+constexpr int kSpmvBlock    = 128;
+constexpr int kShortLanes   = 4;    // lanes per short row
+constexpr int kLongRowMin   = 33;   // rows with at least this many blocks take a whole thread block
+constexpr int kMaxShortGrid = 512;
+constexpr int kMaxLongGrid  = 64;
+
+__global__ void flag_long_rows(int rows, const int* row_offsets, int* flag)
+{
+    int r = blockIdx.x * blockDim.x + threadIdx.x;
+    if(r < rows)
+        flag[r] = (row_offsets[r + 1] - row_offsets[r]) >= kLongRowMin ? 1 : 0;
+    else if(r == rows)
+        flag[r] = 0;
+}
+
+__global__ void split_rows(int rows, const int* flag, const int* pos, int* short_rows, int* long_rows)
+{
+    int r = blockIdx.x * blockDim.x + threadIdx.x;
+    if(r >= rows)
+        return;
+    if(flag[r])
+        long_rows[pos[r]] = r;
+    else
+        short_rows[r - pos[r]] = r;
+}
+
+// one row by L lanes; every lane calls it (shuffles); returns the row's dot contribution on lane 0 of the group
+template <int L>
+__device__ __forceinline__ Float row_product(bool             valid,
+                                             int              r,
+                                             int              lane,
+                                             Float            a,
+                                             Float            b,
+                                             const int*       row_offsets,
+                                             const Matrix3x3* csr_blocks,
+                                             const int*       csr_cols,
+                                             const Float*     x,
+                                             Float*           y)
+{
+    constexpr unsigned full = 0xffffffffu;
+    Float              acc0 = 0, acc1 = 0, acc2 = 0;
+    if(valid)
+    {
+        int end = row_offsets[r + 1];
+        for(int e = row_offsets[r] + lane; e < end; e += L)
+        {
+            const Matrix3x3& blk = csr_blocks[e];
+            int              c   = csr_cols[e];
+            Float            x0 = x[3 * c], x1 = x[3 * c + 1], x2 = x[3 * c + 2];
+            acc0 += blk(0, 0) * x0 + blk(0, 1) * x1 + blk(0, 2) * x2;
+            acc1 += blk(1, 0) * x0 + blk(1, 1) * x1 + blk(1, 2) * x2;
+            acc2 += blk(2, 0) * x0 + blk(2, 1) * x1 + blk(2, 2) * x2;
+        }
+    }
+#pragma unroll
+    for(int k = L / 2; k > 0; k >>= 1)
+    {
+        acc0 += __shfl_xor_sync(full, acc0, k, L);
+        acc1 += __shfl_xor_sync(full, acc1, k, L);
+        acc2 += __shfl_xor_sync(full, acc2, k, L);
+    }
+    Float rd = 0;
+    if(valid && lane == 0)
+    {
+        Float ax0 = a * acc0, ax1 = a * acc1, ax2 = a * acc2;
+        rd        = x[3 * r] * ax0 + x[3 * r + 1] * ax1 + x[3 * r + 2] * ax2;
+        if(b != 0)
+        {
+            ax0 += b * y[3 * r];
+            ax1 += b * y[3 * r + 1];
+            ax2 += b * y[3 * r + 2];
+        }
+        y[3 * r]     = ax0;
+        y[3 * r + 1] = ax1;
+        y[3 * r + 2] = ax2;
+    }
+    return rd;
+}
+
+// blocks [0, grid_short): short rows, LS lanes each; blocks [grid_short, gridDim.x): long rows, full warps
+template <int LS, bool WithDot>
+__global__ void gather_spmv(int              n_short,
+                            int              n_long,
+                            int              grid_short,
+                            const int*       short_rows,
+                            const int*       long_rows,
+                            Float            a,
+                            Float            b,
+                            const int*       row_offsets,
+                            const Matrix3x3* csr_blocks,
+                            const int*       csr_cols,
+                            const Float*     x,
+                            Float*           y,
+                            Float*           partial,
+                            unsigned int*    counter,
+                            Float*           dot_out)
+{
+    __shared__ Float group_dot[kSpmvBlock / LS];
+    __shared__ bool  last;
+    Float            mine = 0;
+    int              lane, group, groups;
+    if(static_cast<int>(blockIdx.x) < grid_short)
+    {
+        constexpr int RPB = kSpmvBlock / LS;
+        lane              = threadIdx.x % LS;
+        group             = threadIdx.x / LS;
+        groups            = RPB;
+        int stride        = grid_short * RPB;
+        int rounds        = (n_short + stride - 1) / stride;  // the same for every thread
+        for(int k = 0; k < rounds; ++k)
+        {
+            int  i     = blockIdx.x * RPB + group + k * stride;
+            bool valid = i < n_short;
+            mine += row_product<LS>(valid, valid ? short_rows[i] : 0, lane, a, b, row_offsets, csr_blocks, csr_cols, x, y);
+        }
+    }
+    else
+    {
+        // long rows: one thread block per row (thread t sums the row's blocks t, t + kSpmvBlock, ... in order; a
+        // cub::BlockReduce, a fixed tree, combines the threads); the blocks loop over the long-row list with a fixed stride
+        using BlockReduceRow = cub::BlockReduce<Float, kSpmvBlock>;
+        __shared__ typename BlockReduceRow::TempStorage row_temp;
+        int grid_long = gridDim.x - grid_short;
+        int rounds    = (n_long + grid_long - 1) / grid_long;  // the same for every thread
+        lane          = threadIdx.x;
+        group         = 0;
+        groups        = 1;
+        for(int k = 0; k < rounds; ++k)
+        {
+            int   i     = (blockIdx.x - grid_short) + k * grid_long;
+            bool  valid = i < n_long;  // the same for the whole thread block
+            int   r     = valid ? long_rows[i] : 0;
+            Float acc0 = 0, acc1 = 0, acc2 = 0;
+            if(valid)
+            {
+                int end = row_offsets[r + 1];
+                for(int e = row_offsets[r] + threadIdx.x; e < end; e += kSpmvBlock)
+                {
+                    const Matrix3x3& blk = csr_blocks[e];
+                    int              c   = csr_cols[e];
+                    Float            x0 = x[3 * c], x1 = x[3 * c + 1], x2 = x[3 * c + 2];
+                    acc0 += blk(0, 0) * x0 + blk(0, 1) * x1 + blk(0, 2) * x2;
+                    acc1 += blk(1, 0) * x0 + blk(1, 1) * x1 + blk(1, 2) * x2;
+                    acc2 += blk(2, 0) * x0 + blk(2, 1) * x1 + blk(2, 2) * x2;
+                }
+            }
+            Float s0 = BlockReduceRow(row_temp).Sum(acc0);
+            __syncthreads();
+            Float s1 = BlockReduceRow(row_temp).Sum(acc1);
+            __syncthreads();
+            Float s2 = BlockReduceRow(row_temp).Sum(acc2);
+            __syncthreads();
+            if(valid && threadIdx.x == 0)
+            {
+                Float ax0 = a * s0, ax1 = a * s1, ax2 = a * s2;
+                mine += x[3 * r] * ax0 + x[3 * r + 1] * ax1 + x[3 * r + 2] * ax2;
+                if(b != 0)
+                {
+                    ax0 += b * y[3 * r];
+                    ax1 += b * y[3 * r + 1];
+                    ax2 += b * y[3 * r + 2];
+                }
+                y[3 * r]     = ax0;
+                y[3 * r + 1] = ax1;
+                y[3 * r + 2] = ax2;
+            }
+        }
+    }
+    if constexpr(WithDot)
+    {
+        if(lane == 0)
+            group_dot[group] = mine;
+        __syncthreads();
+        if(threadIdx.x == 0)
+        {
+            Float s = 0;
+            for(int g = 0; g < groups; ++g)
+                s += group_dot[g];
+            partial[blockIdx.x] = s;
+            __threadfence();
+            last = atomicAdd(counter, 1u) == gridDim.x - 1;  // integer count: order-independent
+        }
+        __syncthreads();
+        if(!last)
+            return;
+        __threadfence();
+        using BlockReduce = cub::BlockReduce<Float, kSpmvBlock>;
+        __shared__ typename BlockReduce::TempStorage temp;
+        Float                                        acc = 0;
+        for(int i = threadIdx.x; i < static_cast<int>(gridDim.x); i += kSpmvBlock)
+            acc += __ldcg(partial + i);
+        Float total = BlockReduce(temp).Sum(acc);
+        if(threadIdx.x == 0)
+        {
+            *dot_out = total;
+            *counter = 0;
+        }
+    }
+}
+
+template <int LS>
+void launch_gather(int n_short, int n_long, const int* short_rows, const int* long_rows, Float a, Float b,
+                   const int* row_offsets, const Matrix3x3* csr_blocks, const int* csr_cols, const Float* x, Float* y,
+                   det::SumScratch* scratch, Float* dot_out)
+{
+    constexpr int rpb_short  = kSpmvBlock / LS;
+    int           grid_short = n_short > 0 ? std::min((n_short + rpb_short - 1) / rpb_short, kMaxShortGrid) : 0;
+    int           grid_long  = n_long > 0 ? std::min(n_long, kMaxLongGrid) : 0;
+    int           grid       = grid_short + grid_long;
+    if(grid == 0)
+        return;
+    if(dot_out)
+    {
+        if(scratch->partial.size() < static_cast<size_t>(grid))
+            scratch->partial.resize(grid);
+        if(scratch->counter.size() == 0)
+        {
+            scratch->counter.resize(1);
+            cudaMemset(scratch->counter.data(), 0, sizeof(unsigned int));
+        }
+        gather_spmv<LS, true><<<grid, kSpmvBlock>>>(n_short, n_long, grid_short, short_rows, long_rows, a, b, row_offsets,
+                                                    csr_blocks, csr_cols, x, y, scratch->partial.data(),
+                                                    scratch->counter.data(), dot_out);
+    }
+    else
+    {
+        gather_spmv<LS, false><<<grid, kSpmvBlock>>>(n_short, n_long, grid_short, short_rows, long_rows, a, b,
+                                                     row_offsets, csr_blocks, csr_cols, x, y, nullptr, nullptr, nullptr);
+    }
+}
+}  // namespace det_spmv_detail
+
+void DetSymSpmv::build(muda::CBCOOMatrixView<Float, 3> A)
+{
+    using namespace det_spmv_detail;
+    constexpr int bd = 256;
+    m_triplets       = A.triplet_count();
+    m_rows           = A.total_rows();
+    int        T     = m_triplets;
+    const int* ri    = A.row_indices().data();
+    const int* ci    = A.col_indices().data();
+
+    m_entry_counts.resize(T + 1);
+    m_entry_offsets.resize(T + 1);
+    count_entries<<<(T + 1 + bd - 1) / bd, bd>>>(T, ri, ci, m_entry_counts.data());
+    size_t bytes = 0;
+    cub::DeviceScan::ExclusiveSum(nullptr, bytes, m_entry_counts.data(), m_entry_offsets.data(), T + 1);
+    if(m_temp.size() < bytes)
+        m_temp.resize(bytes);
+    cub::DeviceScan::ExclusiveSum((void*)m_temp.data(), bytes, m_entry_counts.data(), m_entry_offsets.data(), T + 1);
+    int m = 0;
+    cudaMemcpy(&m, m_entry_offsets.data() + T, sizeof(int), cudaMemcpyDeviceToHost);
+    m_entries = m;
+
+    m_keys_in.resize(m);
+    m_keys_out.resize(m);
+    m_vals_in.resize(m);
+    m_vals_out.resize(m);
+    if(T > 0)
+        fill_entries<<<(T + bd - 1) / bd, bd>>>(T, ri, ci, m_entry_offsets.data(), m_keys_in.data(), m_vals_in.data());
+    bytes = 0;
+    cub::DeviceRadixSort::SortPairs(nullptr, bytes, m_keys_in.data(), m_keys_out.data(), m_vals_in.data(),
+                                    m_vals_out.data(), m);
+    if(m_temp.size() < bytes)
+        m_temp.resize(bytes);
+    cub::DeviceRadixSort::SortPairs((void*)m_temp.data(), bytes, m_keys_in.data(), m_keys_out.data(),
+                                    m_vals_in.data(), m_vals_out.data(), m);
+
+    m_row_counts.resize(m_rows + 1);
+    m_row_offsets.resize(m_rows + 1);
+    cudaMemset(m_row_counts.data(), 0, (m_rows + 1) * sizeof(int));
+    if(m > 0)
+        count_rows<<<(m + bd - 1) / bd, bd>>>(m, m_keys_out.data(), m_row_counts.data());
+    bytes = 0;
+    cub::DeviceScan::ExclusiveSum(nullptr, bytes, m_row_counts.data(), m_row_offsets.data(), m_rows + 1);
+    if(m_temp.size() < bytes)
+        m_temp.resize(bytes);
+    cub::DeviceScan::ExclusiveSum((void*)m_temp.data(), bytes, m_row_counts.data(), m_row_offsets.data(), m_rows + 1);
+
+    m_csr_blocks.resize(m);
+    m_csr_cols.resize(m);
+    m_values = A.values().data();
+    if(m > 0)
+        pack_csr<<<(m + bd - 1) / bd, bd>>>(m, m_vals_out.data(), ri, ci, m_values, m_csr_blocks.data(), m_csr_cols.data());
+
+    // short / long row lists (integer only)
+    m_row_flag.resize(m_rows + 1);
+    m_row_pos.resize(m_rows + 1);
+    flag_long_rows<<<(m_rows + 1 + bd - 1) / bd, bd>>>(m_rows, m_row_offsets.data(), m_row_flag.data());
+    bytes = 0;
+    cub::DeviceScan::ExclusiveSum(nullptr, bytes, m_row_flag.data(), m_row_pos.data(), m_rows + 1);
+    if(m_temp.size() < bytes)
+        m_temp.resize(bytes);
+    cub::DeviceScan::ExclusiveSum((void*)m_temp.data(), bytes, m_row_flag.data(), m_row_pos.data(), m_rows + 1);
+    int n_long = 0;
+    cudaMemcpy(&n_long, m_row_pos.data() + m_rows, sizeof(int), cudaMemcpyDeviceToHost);
+    m_n_long  = n_long;
+    m_n_short = m_rows - n_long;
+    m_short_rows.resize(std::max(m_n_short, 1));
+    m_long_rows.resize(std::max(m_n_long, 1));
+    if(m_rows > 0)
+        split_rows<<<(m_rows + bd - 1) / bd, bd>>>(m_rows, m_row_flag.data(), m_row_pos.data(), m_short_rows.data(),
+                                                   m_long_rows.data());
+    m_built = true;
+}
+
+void DetSymSpmv::run(Float                           a,
+                     muda::CBCOOMatrixView<Float, 3> A,
+                     muda::CDenseVectorView<Float>   x,
+                     Float                           b,
+                     muda::DenseVectorView<Float>    y,
+                     Float*                          dot_out)
+{
+    using namespace det_spmv_detail;
+    UIPC_ASSERT(m_built && m_triplets == A.triplet_count() && m_values == A.values().data() && 3 * m_rows == x.size()
+                    && x.size() == y.size(),
+                "DetSymSpmv: the expanded CSR does not match the matrix (rebuild after assembling A)");
+    if(m_rows <= 0)
+        return;
+    const int*       ro = m_row_offsets.data();
+    const Matrix3x3* cb = m_csr_blocks.data();
+    const int*       cc = m_csr_cols.data();
+    const int*       sr = m_short_rows.data();
+    const int*       lr = m_long_rows.data();
+    launch_gather<kShortLanes>(m_n_short, m_n_long, sr, lr, a, b, ro, cb, cc, x.data(), y.data(), &m_dot_scratch, dot_out);
+}
+
+void DetSymSpmv::spmv(Float                           a,
+                      muda::CBCOOMatrixView<Float, 3> A,
+                      muda::CDenseVectorView<Float>   x,
+                      Float                           b,
+                      muda::DenseVectorView<Float>    y)
+{
+    run(a, A, x, b, y, nullptr);
+}
+
+void DetSymSpmv::spmv_dot(Float                           a,
+                          muda::CBCOOMatrixView<Float, 3> A,
+                          muda::CDenseVectorView<Float>   x,
+                          Float                           b,
+                          muda::DenseVectorView<Float>    y,
+                          muda::VarView<Float>            d_dot)
+{
+    run(a, A, x, b, y, d_dot.data());
+}
