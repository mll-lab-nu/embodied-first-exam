<!--
  Robot table tennis scene for robot_coding_bench.
  * Ball, table, net and the ball-table contact pair: Google DeepMind competitive_robot_table_tennis
    (system-identified MJCF from ball_states_viz.ipynb, Apache-2.0). World frame: table top at z=0, the long
    axis is y, the net is the plane y=0. The opponent half is y>0; the robot stands behind the y<0 end.
  * Arm: MuJoCo Menagerie franka_emika_panda/panda_nohand.xml (Apache-2.0, assets/LICENSE.menagerie-franka),
    collision meshes only (also used for display), torque (motor) actuators at the Franka torque limits.
    The joint-space controller (PD + bias compensation) runs in rcb_tt.py at every 1 ms physics step.
  * Paddle: a 15 x 15 x 1.5 cm box blade on a short handle bolted to the flange instead of the hand.
    The blade face normal is the paddle's local +x axis; the handle runs along the flange z axis.
    The ball-paddle contact parameters are hand-picked (not system-identified).
-->
<mujoco model="rcb_tabletennis">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option density="1.225" viscosity="1.8e-5" wind="0 0 0" integrator="implicitfast" timestep="0.001"
          cone="elliptic" impratio="10"/>
  <size memory="20M"/>

  <visual>
    <headlight diffuse=".5 .5 .5" specular=".3 .3 .3"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <default class="panda">
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <geom type="mesh" rgba="0.92 0.93 0.94 1" group="2"/>
      <motor ctrlrange="-87 87"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".55 .6 .7" rgb2="0.1 0.1 0.15" width="10" height="10"/>
    <texture type="2d" name="floor" builtin="checker" rgb1=".32 .32 .36" rgb2=".26 .26 .3" width="300" height="300"/>
    <material name="floor" texture="floor" texrepeat="8 8"/>
    <mesh name="link0_c" file="link0.stl"/>
    <mesh name="link1_c" file="link1.stl"/>
    <mesh name="link2_c" file="link2.stl"/>
    <mesh name="link3_c" file="link3.stl"/>
    <mesh name="link4_c" file="link4.stl"/>
    <mesh name="link5_c0" file="link5_collision_0.obj"/>
    <mesh name="link5_c1" file="link5_collision_1.obj"/>
    <mesh name="link5_c2" file="link5_collision_2.obj"/>
    <mesh name="link6_c" file="link6.stl"/>
    <mesh name="link7_c" file="link7.stl"/>
  </asset>

  <worldbody>
    <light pos="0 -0.5 3" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" castshadow="false"/>
    <geom name="floor" type="plane" size="6 6 0.1" pos="0 0 -0.76" material="floor"/>

    <body name="ball" pos="0.0 1.4 0.3">
      <inertial pos="0 0 0" mass="2.7e-3" diaginertia="0.00000072 0.00000072 0.00000072"/>
      <freejoint name="ball"/>
      <geom name="geom_ball" size=".02" shellinertia="false" fluidcoef="0.235 0.25 0.0 1.0 1.0" group="1"
            rgba="0.98 0.70 0.015 1" solref="-100000 -0" fluidshape="ellipsoid"/>
    </body>

    <body name="table" pos="0 0 -0.76" quat="0.7071068 0 0 0.7071068">
      <geom name="geom_table" size="1.37 0.7625 0.02" pos="0 0 0.74" type="box" rgba="0.27 0.51 0.14 1"/>
      <geom name="geom_net" size="0.005 0.915 0.07625" pos="0 0 0.83625" type="box" rgba="1 1 1 0.5"/>
      <geom size="1.371 0.7635 0.02" pos="0 0 0.739" type="box" contype="0" conaffinity="0" group="1"
            density="0" rgba="0 0 0 1"/>
      <geom size="0.03 0.03 0.36" pos="1.1 0.6 0.36" type="box" contype="0" conaffinity="0" rgba=".2 .2 .2 1"/>
      <geom size="0.03 0.03 0.36" pos="1.1 -0.6 0.36" type="box" contype="0" conaffinity="0" rgba=".2 .2 .2 1"/>
      <geom size="0.03 0.03 0.36" pos="-1.1 0.6 0.36" type="box" contype="0" conaffinity="0" rgba=".2 .2 .2 1"/>
      <geom size="0.03 0.03 0.36" pos="-1.1 -0.6 0.36" type="box" contype="0" conaffinity="0" rgba=".2 .2 .2 1"/>
    </body>

    <!-- visual target zone on the opponent half (the verifier uses the numbers in instance.npz) -->
    <site name="target_zone" type="box" pos="0 1 0.0005" size="0.2 0.2 0.0005" rgba="1 0.2 0.2 0.45"/>

    <!-- pedestal: visual only -->
    <geom name="pedestal" type="cylinder" size="0.12 0.38" pos="0 -1.75 -0.38" contype="0" conaffinity="0"
          rgba=".25 .25 .28 1"/>

    <body name="link0" childclass="panda" pos="0 -1.75 0" quat="0.7071068 0 0 0.7071068">
      <inertial mass="0.629769" pos="-0.041018 -0.00014 0.049974"
        fullinertia="0.00315 0.00388 0.004285 8.2904e-7 0.00015 8.2299e-6"/>
      <geom name="link0_c" mesh="link0_c"/>
      <body name="link1" pos="0 0 0.333">
        <inertial mass="4.970684" pos="0.003875 0.002081 -0.04762"
          fullinertia="0.70337 0.70661 0.0091170 -0.00013900 0.0067720 0.019169"/>
        <joint name="joint1"/>
        <geom name="link1_c" mesh="link1_c"/>
        <body name="link2" quat="1 -1 0 0">
          <inertial mass="0.646926" pos="-0.003141 -0.02872 0.003495"
            fullinertia="0.0079620 2.8110e-2 2.5995e-2 -3.925e-3 1.0254e-2 7.04e-4"/>
          <joint name="joint2" range="-1.7628 1.7628"/>
          <geom name="link2_c" mesh="link2_c"/>
          <body name="link3" pos="0 -0.316 0" quat="1 1 0 0">
            <joint name="joint3"/>
            <inertial mass="3.228604" pos="2.7518e-2 3.9252e-2 -6.6502e-2"
              fullinertia="3.7242e-2 3.6155e-2 1.083e-2 -4.761e-3 -1.1396e-2 -1.2805e-2"/>
            <geom name="link3_c" mesh="link3_c"/>
            <body name="link4" pos="0.0825 0 0" quat="1 1 0 0">
              <inertial mass="3.587895" pos="-5.317e-2 1.04419e-1 2.7454e-2"
                fullinertia="2.5853e-2 1.9552e-2 2.8323e-2 7.796e-3 -1.332e-3 8.641e-3"/>
              <joint name="joint4" range="-3.0718 -0.0698"/>
              <geom name="link4_c" mesh="link4_c"/>
              <body name="link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                <inertial mass="1.225946" pos="-1.1953e-2 4.1065e-2 -3.8437e-2"
                  fullinertia="3.5549e-2 2.9474e-2 8.627e-3 -2.117e-3 -4.037e-3 2.29e-4"/>
                <joint name="joint5"/>
                <geom name="link5_c0" mesh="link5_c0"/>
                <geom name="link5_c1" mesh="link5_c1"/>
                <geom name="link5_c2" mesh="link5_c2"/>
                <body name="link6" quat="1 1 0 0">
                  <inertial mass="1.666555" pos="6.0149e-2 -1.4117e-2 -1.0517e-2"
                    fullinertia="1.964e-3 4.354e-3 5.433e-3 1.09e-4 -1.158e-3 3.41e-4"/>
                  <joint name="joint6" range="-0.0175 3.7525"/>
                  <geom name="link6_c" mesh="link6_c"/>
                  <body name="link7" pos="0.088 0 0" quat="1 1 0 0">
                    <inertial mass="7.35522e-01" pos="1.0517e-2 -4.252e-3 6.1597e-2"
                      fullinertia="1.2516e-2 1.0027e-2 4.815e-3 -4.28e-4 -1.196e-3 -7.41e-4"/>
                    <joint name="joint7"/>
                    <geom name="link7_c" mesh="link7_c"/>
                    <body name="paddle" pos="0 0 0.107">
                      <!-- handle along the flange z axis; blade centre 0.14 m beyond the flange -->
                      <geom name="paddle_handle" type="capsule" fromto="0 0 0 0 0 0.06" size="0.014"
                            mass="0.05" rgba="0.55 0.35 0.2 1" group="2"/>
                      <geom name="paddle_blade" type="box" pos="0 0 0.14" size="0.0075 0.075 0.075"
                            mass="0.09" rgba="0.75 0.08 0.08 1" group="2"/>
                      <site name="paddle_center" pos="0 0 0.14" size="0.005" rgba="1 1 1 1" group="4"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="link0" body2="link1"/>
    <exclude body1="link7" body2="paddle"/>
    <exclude body1="link6" body2="paddle"/>
    <!-- system-identified ball-table contact (DeepMind) -->
    <pair geom1="geom_ball" geom2="geom_table" solref="-1000000 -17" friction="0.1 0.1 0.005 0.0001 0.0001"
          solimp="0.98 0.99 0.001 0.5 2" solreffriction="-0.0 -200.0"/>
    <!-- ball-paddle contact: hand-picked, NOT system-identified -->
    <pair geom1="geom_ball" geom2="paddle_blade" solref="-600000 -12" friction="0.8 0.8 0.005 0.0001 0.0001"
          solimp="0.98 0.99 0.001 0.5 2" solreffriction="-0.0 -200.0"/>
  </contact>

  <actuator>
    <motor class="panda" name="motor1" joint="joint1"/>
    <motor class="panda" name="motor2" joint="joint2"/>
    <motor class="panda" name="motor3" joint="joint3"/>
    <motor class="panda" name="motor4" joint="joint4"/>
    <motor class="panda" name="motor5" joint="joint5" ctrlrange="-12 12"/>
    <motor class="panda" name="motor6" joint="joint6" ctrlrange="-12 12"/>
    <motor class="panda" name="motor7" joint="joint7" ctrlrange="-12 12"/>
  </actuator>
</mujoco>
