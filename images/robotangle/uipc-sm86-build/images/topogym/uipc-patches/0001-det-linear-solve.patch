diff --git a/src/backends/cuda/linear_system/det_reduce.h b/src/backends/cuda/linear_system/det_reduce.h
new file mode 100644
index 0000000..f120db8
--- /dev/null
+++ b/src/backends/cuda/linear_system/det_reduce.h
@@ -0,0 +1,90 @@
+#pragma once
+// Deterministic reductions (TopoGym determinism series, patch 0001).
+//
+// Replaces float atomicAdd reductions (e.g. warp sums atomically added into one device scalar), whose summation order
+// follows the GPU scheduler and so changes the rounding from run to run. Here the grid size is a function of n only,
+// every thread sums a fixed index set in a fixed order and cub::BlockReduce combines a block with a fixed shuffle tree;
+// the last block to finish (found with an integer atomic counter) then sums the per-block partials in index order.
+// Which block happens to be last does not matter: it computes the same fixed-order sum. One kernel launch per sum.
+// Same GPU model and n => same bits.
+#include <type_define.h>
+#include <cub/block/block_reduce.cuh>
+#include <muda/buffer/device_buffer.h>
+
+namespace uipc::backend::cuda::det
+{
+constexpr int kBlockDim = 256;
+constexpr int kMaxGrid  = 1024;
+
+inline int grid_size(int n)
+{
+    int g = (n + kBlockDim * 4 - 1) / (kBlockDim * 4);
+    return g < 1 ? 1 : (g > kMaxGrid ? kMaxGrid : g);
+}
+
+// scratch of one call site: per-block partials and the completion counter (0 between calls)
+struct SumScratch
+{
+    muda::DeviceBuffer<Float>        partial;
+    muda::DeviceBuffer<unsigned int> counter;
+};
+
+template <typename Load>
+__global__ void sum_kernel(int n, Load load, Float* partial, unsigned int* counter, Float* out)
+{
+    using BlockReduce = cub::BlockReduce<Float, kBlockDim>;
+    __shared__ typename BlockReduce::TempStorage temp;
+    __shared__ bool                              last;
+    Float acc = 0;
+    for(int i = blockIdx.x * kBlockDim + threadIdx.x; i < n; i += gridDim.x * kBlockDim)
+        acc += load(i);
+    Float s = BlockReduce(temp).Sum(acc);
+    if(threadIdx.x == 0)
+    {
+        partial[blockIdx.x] = s;
+        __threadfence();
+        last = atomicAdd(counter, 1u) == gridDim.x - 1;  // integer count: order-independent
+    }
+    __syncthreads();
+    if(!last)
+        return;
+    __threadfence();
+    Float acc2 = 0;
+    for(int i = threadIdx.x; i < static_cast<int>(gridDim.x); i += kBlockDim)
+        acc2 += __ldcg(partial + i);
+    Float total = BlockReduce(temp).Sum(acc2);
+    if(threadIdx.x == 0)
+    {
+        *out     = total;
+        *counter = 0;
+    }
+}
+
+// *out (device) = sum_{i<n} load(i), bit-reproducible. Default stream.
+template <typename Load>
+void sum(int n, Load load, SumScratch& scratch, Float* out)
+{
+    int g = grid_size(n);
+    if(scratch.partial.size() < static_cast<size_t>(g))
+        scratch.partial.resize(g);
+    if(scratch.counter.size() == 0)
+    {
+        scratch.counter.resize(1);
+        cudaMemset(scratch.counter.data(), 0, sizeof(unsigned int));
+    }
+    sum_kernel<<<g, kBlockDim>>>(n, load, scratch.partial.data(), scratch.counter.data(), out);
+}
+
+struct DotLoad
+{
+    const Float* x;
+    const Float* y;
+    __device__ Float operator()(int i) const { return x[i] * y[i]; }
+};
+
+struct ArrayLoad
+{
+    const Float* a;
+    __device__ Float operator()(int i) const { return a[i]; }
+};
+}  // namespace uipc::backend::cuda::det
