# Standard-realtime mode: the agent container has NO simulator and no Panda Dynamic Scenes code: only Python and the
# realtime client (eai-standard/2.3).
# The client base image and the pip pins are the shared ones of every standard task (scripts/eai_standard/client.env).
FROM @@CLIENT_IMAGE@@
COPY client-requirements.txt /tmp/client-requirements.txt
RUN pip install --no-cache-dir -r /tmp/client-requirements.txt
COPY rcb_client.py rcb1.py /opt/tools/
ENV PYTHONPATH=/opt/tools
RUN mkdir -p /app/output
WORKDIR /app
