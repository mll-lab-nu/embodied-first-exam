COPY . /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:robocasa365-files-0.6.0@sha256:24d6c45e6433931ad97c1821c684d54abfefb6c190218554a16554d2b00c6051 \
     /privileged/environment/casa_tool.py \
     /sim/rcb_service.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:standard-files-0.5.0@sha256:ff602baf1ef852d21ecf0152d94cf210c8b691a5bdaa88d00dc381f6150b98cb \
     /rcb1.py \
     /realtime/rcb_realtime.py \
     /srv/
