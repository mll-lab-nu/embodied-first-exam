COPY --from=ghcr.io/mll-lab-nu/efe:humanoidbench-files-0.6.0@sha256:e5ed5c010c58f3065239d69d99bbcb7dcbc56124348b7950e76acf42ba8769b6 \
     /privileged/environment/rcb_hb.py \
     /privileged/tests/rcb_rewards.py \
     /sim/rcb_service.py \
     /sim/server.py \
     /srv/
