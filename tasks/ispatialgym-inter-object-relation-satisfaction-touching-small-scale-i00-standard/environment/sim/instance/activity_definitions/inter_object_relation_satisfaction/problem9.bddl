(define (problem inter_object_relation_satisfaction-9)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-inside_small_scale-sunflower-vase-coffee_table)

    ; IORS - inside (small-scale). Target lowered into the partner (fillable container) on the support; the target's
    ; goal orientation is whatever settles (TRO orientation_metric null), which also admits flowers stood in vases. Both
    ; poses measured. The insert grasp pipeline (pads on the upper part of the object so the lower body can enter the
    ; container; flowers held by the upper stem) is required.

    (:objects
        sunflower.n.01_1 - sunflower.n.01
        vase.n.01_1 - vase.n.01
        coffee_table.n.01_1 - coffee_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop sunflower.n.01_1 coffee_table.n.01_1)
        (ontop vase.n.01_1 coffee_table.n.01_1)
        (not (inside sunflower.n.01_1 vase.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?sunflower.n.01_1 ?vase.n.01_1)
            (not (grasped ?agent.n.01_1 ?sunflower.n.01_1))
            (not (grasped ?agent.n.01_1 ?vase.n.01_1))
            (pose_settled ?sunflower.n.01_1)
            (pose_settled ?vase.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?sunflower.n.01_1)
        (pose_reached ?vase.n.01_1)
    )
)
