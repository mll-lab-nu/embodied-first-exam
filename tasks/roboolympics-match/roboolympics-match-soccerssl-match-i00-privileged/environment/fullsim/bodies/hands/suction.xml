<mujoco model="hand_suction">
  <!-- Draft: a switchable suction hand (basketball dribble). The cup faces +z; the sport adds the grip (an adhesion
       actuator or a weld that it switches on and off) and its rules. -->
  <worldbody>
    <body name="hand">
      <geom name="body" type="cylinder" fromto="0 0 0 0 0 0.08" size="0.04" mass="0.30" rgba="0.2 0.2 0.22 1" group="2"/>
      <geom name="cup" type="cylinder" fromto="0 0 0.08 0 0 0.10" size="0.08" mass="0.10" rgba="0.95 0.45 0.1 1" group="2"/>
      <site name="center" pos="0 0 0.10" size="0.005" group="4"/>
    </body>
  </worldbody>
</mujoco>
