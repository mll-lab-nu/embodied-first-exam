# Standard mode: the simulator runs in the `sim` sidecar (agent cannot open it); the agent only reaches port 8000.
# No `expose`/`ports` on sim: under Harbor's egress control it shares main's network namespace (localhost:8000).
# `/data` is the licensed BEHAVIOR-1K 3.7.2 data root here (read-only; $RCB_MANIGUARD_DATA is a precondition of every
# ManiGuard run, docs/benchmarks/maniguard.md), so the service writes its own record to `/out` (the container's own file
# system: it survives compose's restarts of the same container). Crash recovery (docs/STANDARD_MODE.md §13): run.sh
# exits non-zero when the service crashes and compose restarts the container, which resumes the same episode from its
# journal. The sidecar is TRUSTED: its Kit cache is a trusted volume of this trial only (no fixed name), never mounted where
# agent code runs. RCB_STARTUP_TIMEOUT_S: the startup watchdog, at least twice the slowest measured scene build
# (docs/benchmarks/maniguard.md; provisional until measured).
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
      - ${RCB_MANIGUARD_DATA:?set RCB_MANIGUARD_DATA to the host directory prepared by scripts/maniguard/prep_data.py (docs/benchmarks/maniguard.md)}:/data:ro
      - rcb_maniguard_cache_trusted:/cache
    working_dir: /tmp
    command: sh /srv/run.sh
    restart: on-failure:6
    environment:
      OMP_NUM_THREADS: "8"
      MKL_NUM_THREADS: "8"
      RCB_TASK: @@MG_TASK@@
      RCB_INSTANCE: /srv/instance
      RCB_TOOL: /srv/rcb_maniguard.py
      RCB_DATA: /out
      RCB_WALL_CLOCK_S: "@@BUDGET@@"
      RCB_CAM_SIZE: "256"           # every camera at 256x256 (ManiGuard's evaluator resolution)
      RCB_STARTUP_TIMEOUT_S: "1800"
      RCB_TASK_TEXT: "@@TASK_TEXT_YAML@@"
      PYTHONPATH: /srv
      RCB_SESSION_LOG: ""           # the sidecar's own Session must not write the agent-side interaction log
    shm_size: "8gb"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
volumes:
  rcb_maniguard_cache_trusted:
