COPY --from=ghcr.io/mll-lab-nu/efe:mujoco-playground-files-0.10.0@sha256:d3036c958ee18f62d28e156212b36c09c2af4f5da3e11948f99fcb171473fc26 \
     /privileged/environment/rcb_panda.py \
     /sim/server_mj.py \
     /srv/
