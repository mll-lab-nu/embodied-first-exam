     /rcb1.py \
     /realtime/rcb_realtime.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:humanoidbench-files-0.5.0@sha256:1bb5889e1d723c4d0c27d43267f256b5b81cadb378a51aef7b8b739faf4394d3 \
     /privileged/environment/rcb_hb.py \
     /privileged/tests/rcb_rewards.py \
     /sim/rcb_service.py \
     /sim/server.py \
     /srv/
