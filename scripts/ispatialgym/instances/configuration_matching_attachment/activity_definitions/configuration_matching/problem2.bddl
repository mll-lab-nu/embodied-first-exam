(define (problem configuration_matching-2)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_close_large_scale-dishwasher)

    ; Configuration matching - articulation (large-scale, close). Scene articulated object (roles/candidates.csv kind scene, bound per
    ; scene; joint from the customs list roles.target.joint / handle_key), one joint open at q_init in S (must satisfy Open)
    ; -> closed limit. Handle grasp in this direction too; base / trunk primary, arm secondary.

    (:objects
        dishwasher.n.01_1 - dishwasher.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open dishwasher.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?dishwasher.n.01_1))
            (not (grasped ?agent.n.01_1 ?dishwasher.n.01_1))
            (pose_settled ?dishwasher.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (layout_reached ?dishwasher.n.01_1)
    )
)
