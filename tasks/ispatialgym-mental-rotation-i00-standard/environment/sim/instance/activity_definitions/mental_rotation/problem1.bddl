(define (problem mental_rotation-1)
    (:domain ispatialgym)
    (:variant mental_rotation-teaspoon)

    ; Mental rotation. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a world-frame
    ; orientation of the target, its position unchanged (TRO pose target: orientation_metric = full, equivalences per model).

    (:objects
        teaspoon.n.02_1 - teaspoon.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 teaspoon.n.02_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?teaspoon.n.02_1)
            (pose_reached ?teaspoon.n.02_1)
            (pose_settled ?teaspoon.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?teaspoon.n.02_1)
    )
)
