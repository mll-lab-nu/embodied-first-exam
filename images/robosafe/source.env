# The native RoboSafeBench source pin and version; fetch_context.sh additionally replays the exact metadata-only
# PUBLIC_SOURCE_PROJECTION.json. images/robosafe/VERSION is the separate candidate image tag.
ROBOSAFEBENCH_COMMIT=2c6360ccca8132bdfdf2f18bf0f16112d04b1b0a
ROBOSAFEBENCH_VERSION=0.5.4.dev1
# MuJoCo Menagerie, public: the robot models RoboSafeBench vendors are byte-for-byte copies of this commit
# (RoboSafeBench assets/third_party/README.md); the image takes them from here and checks context/menagerie.sha256.
MENAGERIE_REPO=https://github.com/google-deepmind/mujoco_menagerie.git
MENAGERIE_COMMIT=0059d4335f8156206f63a35662313385f7ad6d74
