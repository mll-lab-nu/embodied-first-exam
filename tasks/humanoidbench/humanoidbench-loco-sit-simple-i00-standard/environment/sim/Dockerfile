COPY --from=ghcr.io/mll-lab-nu/efe:humanoidbench-files-0.6.0@sha256:88b881a25e2af7d50bde212c839aa50dee16117532eb19c7208db454fef9af2d \
     /privileged/environment/rcb_hb.py \
     /privileged/tests/rcb_rewards.py \
     /sim/rcb_service.py \
     /sim/server.py \
     /srv/
