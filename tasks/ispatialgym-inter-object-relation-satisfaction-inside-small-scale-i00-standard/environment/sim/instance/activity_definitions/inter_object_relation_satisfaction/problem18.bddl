(define (problem inter_object_relation_satisfaction-18)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-under_small_scale-spatula-paper_sheet-commercial_kitchen_table)

    ; IORS - under (small-scale). Both objects on the support; the manipulated target (glass, teacup, fries, bottle) is set
    ; down centred on the partner (coaster, saucer, platter, tray) so that the PARTNER ends under the target. Argument order
    ; is therefore (under partner target). Both poses measured.

    (:objects
        spatula.n.01_1 - spatula.n.01
        sheet.n.02_1 - sheet.n.02
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop spatula.n.01_1 countertop.n.01_1)
        (ontop sheet.n.02_1 countertop.n.01_1)
        (not (under sheet.n.02_1 spatula.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (under ?sheet.n.02_1 ?spatula.n.01_1)
            (not (grasped ?agent.n.01_1 ?spatula.n.01_1))
            (not (grasped ?agent.n.01_1 ?sheet.n.02_1))
            (pose_settled ?spatula.n.01_1)
            (pose_settled ?sheet.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?spatula.n.01_1)
        (pose_reached ?sheet.n.02_1)
    )
)
