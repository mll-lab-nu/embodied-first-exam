schema_version = "1.3"
artifacts = ["/app/output/"]

[task]
name = "robot-coding-bench/@@PRIV@@"
description = "RoboOlympics @@FAMILY@@ (one @@ROBOT_TITLE@@ on the RoboOlympics simulator, MuJoCo 3.3.7, CPU) in privileged mode: produce one replayable trajectory. @@SENTENCE_TOML@@ A referee of events, geometry and contact rules decides the success."
authors = [{ name = "Kangrui Wang" }]
keywords = ["robotics", "roboolympics", "sports", "mujoco", "@@ROBOT_KW@@", "humanoid", "trajectory", "@@FAMILY@@"]

[metadata]
author_name = "Kangrui Wang"
task_type = "trajectory"
simulator = "mujoco"               # the RoboOlympics simulator: MuJoCo 3.3.7 on the CPU with RoboOlympics' robot library
robot = "@@ROBOT_ID@@"
family = "@@FAMILY_ID@@"
category = "@@CATEGORY@@"
mode = "privileged"
network = "open"                 # the agent's egress (docs/protocol/README.md §2): open, the author's choice
# scene = environment/instance.json (the family's parameters + its t = 0 state hash); identity = the dataset.toml digest
instance_seed = @@SEED@@
expert_time_estimate_hours = @@EXPERT_HOURS@@
oracle = "@@ORACLE@@"
oracle_evidence = "@@ORACLE_EVIDENCE@@"

[verifier]
timeout_sec = 900.0
# grade.py runs in its own container (tests/Dockerfile): the agent's container is gone by then and only /app/output/
# crosses over. It replays in two fresh processes, with no network.
environment_mode = "separate"
network_mode = "no-network"

[verifier.environment]
build_timeout_sec = 1800.0
cpus = 4
memory_mb = 8192

[agent]
timeout_sec = @@AGENT_TIMEOUT@@.0
# Egress: open (Harbor's default), as `[metadata] network` declares. RoboOlympics lets the agent search for and download
# public tools, robot models and pretrained controllers (owner, 2026-10-11; docs/benchmarks/roboolympics.md).

[environment]
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 16384
