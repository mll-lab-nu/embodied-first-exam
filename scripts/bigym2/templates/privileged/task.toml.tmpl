schema_version = "1.3"
artifacts = ["/app/output/"]

[task]
name = "robot-coding-bench/@@PRIV@@"
description = "BiGym 2.0 @@FAMILY@@ (Unitree G1 with GR00T-WBC, MuJoCo 3.8.1) in privileged mode: produce one replayable trajectory. @@SENTENCE_TOML@@ Frozen instance: upstream task @@TASK@@, seed @@SEED@@."
authors = [{ name = "pingyue" }]
keywords = ["robotics", "bigym2", "mujoco", "unitree-g1", "humanoid", "loco-manipulation", "trajectory", "@@FAMILY@@"]

[metadata]
author_name = "pingyue"
task_type = "trajectory"
simulator = "bigym2"               # BiGym 2.0 (bigym 1.0.0 at 93ad4b3): MuJoCo 3.8.1 + NVIDIA GR00T-WBC, CPU physics
robot = "unitree-g1-dex1"
family = "@@FAMILY@@"
mode = "privileged"
# scene = environment/instance.json (upstream's task reset with this seed + its t = 0 state hash); identity = the dataset.toml digest
instance_seed = @@SEED@@
expert_time_estimate_hours = 2.0
oracle = "none"
oracle_evidence = "@@ORACLE_EVIDENCE@@"

[verifier]
timeout_sec = 1800.0
# grade.py runs in its own container (tests/Dockerfile): the agent's container is gone by then and only /app/output/
# crosses over. It replays in two fresh processes, with no network.
environment_mode = "separate"
network_mode = "no-network"

[verifier.environment]
build_timeout_sec = 1800.0
cpus = 4
memory_mb = 16384

[agent]
timeout_sec = 3600.0
# The model APIs and nothing else (scripts/set_agent_egress.py HOSTS): BiGym 2.0's demonstrations and its coding agents'
# programs and rollouts are public (Hugging Face SWIRL-Lab/bigym-g1-native60 and bigym2-agent-rollouts).
network_mode = "allowlist"
allowed_hosts = [@@HOSTS@@]

[environment]
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 16384
