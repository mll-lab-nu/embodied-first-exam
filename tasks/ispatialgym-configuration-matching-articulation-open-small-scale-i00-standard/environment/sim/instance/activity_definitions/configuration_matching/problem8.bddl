(define (problem configuration_matching-8)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_open_small_scale-carton-desk)

    ; Configuration matching - articulation (small-scale, open). Spawned articulated object (toolbox, carton, hinged jar) on
    ; the support (floor for objects taller than 0.6 m), facing the robot; closed -> open to q_goal in S. Handle arm + brace
    ; arm on the base link (brace computed geometrically); the object's root pose is measured (pose_reached in :measure),
    ; not gated. Joint from the customs list (roles.target.joint / handle_key).

    (:objects
        carton.n.02_1 - carton.n.02
        desk.n.01_1 - desk.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (not (open carton.n.02_1))
        (ontop carton.n.02_1 desk.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (open ?carton.n.02_1)
            (ontop ?carton.n.02_1 ?desk.n.01_1)
            (not (grasped ?agent.n.01_1 ?carton.n.02_1))
            (pose_settled ?carton.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?carton.n.02_1)
        (layout_reached ?carton.n.02_1)
    )
)
