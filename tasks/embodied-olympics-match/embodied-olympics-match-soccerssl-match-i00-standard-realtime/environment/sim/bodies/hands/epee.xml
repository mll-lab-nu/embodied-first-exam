<mujoco model="hand_epee">
  <!-- An epee (FIE Material Rules, August 2026: m.14 under 770 g ready for use, no balance rule; m.16.3 blade at most
       90 cm; m.17.1 guard through a 13.5 cm gauge). Blade along +z from the grip at the mount.
       Mass (2026-10-11, from Leon Paul's catalogue, leonpaulusa.com: FIE maraging blades 150-183 g at 89-89.5 cm,
       electric guards 86-133 g at 13.3 cm, grips 42-62 g, French pommels up to 200 g; "an epee made with all standard
       parts and a traditional blade weighs 454 g"): grip, pommel and nut 0.14 kg (centre 0.05 m), guard 0.13 kg (a
       disc at 0.105 m), blade with its wire 0.175 kg (tapered: centre of mass 35 % along it, 0.425 m), point 0.01 kg
       (1.01 m): 0.455 kg, centre of mass 0.231 m from the mount (12 cm in front of the guard). The inertial below
       carries it (inertia about the centre of mass: the blade and grip as rods, the guard as a disc); the geoms carry
       the shape only. Until 2026-10-11 the draft had 0.76 kg with a 0.45 kg blade (centre 0.375 m): a G1 holding it on
       guard used 76 % of its wrist pitch motor's torque, 37 % with this one (docs/screening/fencing.md, F0). -->
  <worldbody>
    <body name="hand">
      <inertial pos="0 0 0.2310" mass="0.455" diaginertia="0.03138 0.03138 0.00030"/>
      <geom name="grip" type="capsule" fromto="0 0 0 0 0 0.10" size="0.015" mass="0" rgba="0.15 0.15 0.15 1" group="2"/>
      <geom name="guard" type="cylinder" fromto="0 0 0.10 0 0 0.11" size="0.0675" mass="0" rgba="0.8 0.8 0.85 1" group="2"/>
      <geom name="blade" type="capsule" fromto="0 0 0.11 0 0 1.01" size="0.005" mass="0" rgba="0.75 0.77 0.8 1" group="2"/>
      <geom name="tip" type="sphere" pos="0 0 1.01" size="0.007" mass="0" rgba="0.2 0.2 0.2 1" group="2"/>
      <site name="tip" pos="0 0 1.017" size="0.004" group="4"/>
    </body>
  </worldbody>
</mujoco>
