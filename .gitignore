# Virtual environment & caches
.venv/
.venv-gs110/
.venv-gs121/
.venv-gs121-nyx/
.venv-harbor/
.cache/
.external/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
__nyx_cache__/
.ipynb_checkpoints/

# Environment files (same public example exception as robot_coding_bench)
.env
.env.*
!.env.example
.secrets/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Run outputs & recordings (videos, frames, datasets, logs)
*.log
/outputs/
/MUJOCO_LOG.TXT
runs/
task_rollouts/
# Retired generated Harbor tasks; current tasks/ stays versioned.
/harbor_tasks/
# Full local proof evidence; small catalogs/manifests/docs remain versionable.
/solvability_proof/*/*/evidence/
bash_scripts/recordings/

# TetGen scratch files (dumped into repo root during soft-body meshing)
tetgen-tmpfile*

# Weekly report decks (per-week folders with copied demo videos; shared by zip, not git)
topogym_weekly_report/

# Archived implementations and demos stay on the local machine, outside Git.
/legacy/
/demos/

# Harbor runs (robot_coding_bench layout): job outputs and local credentials stay out of git
/jobs/
/exps/
/topogym-work/
