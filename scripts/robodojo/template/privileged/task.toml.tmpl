# Generated by scripts/robodojo/mk_tasks.py -- edit the template or scripts/robodojo/descr/, not this.
schema_version = "1.3"
artifacts = ["/app/output/"]

[task]
name = "robot-coding-bench/@@PRIV@@"
description = "RoboDojo @@TASK@@ (@@DIMENSION@@; two ARX X5 arms with parallel grippers, Isaac Sim 5.1 / Isaac Lab): produce one replayable trajectory of RoboDojo's 14-D joint actions. @@GOAL_TOML@@ Frozen scene instance: RoboDojo's own evaluation layout @@LAYOUT_FILE@@; graded by RoboDojo's own reward check."
authors = [{ name = "Changhe Chen" }]
keywords = ["robotics", "robodojo", "isaac-lab", "isaac-sim", "bimanual", "arx-x5", "code-as-policy", "trajectory", "privileged"]

[metadata]
author_name = "Changhe Chen"
author_org = "MLL Lab"
task_type = "trajectory"
simulator = "robodojo"            # RoboDojo @ cb2a37d on its Isaac Lab 2.3 fork / Isaac Sim 5.1 (PhysX, RTX rendering)
robot = "arx-x5-bimanual"
family = "@@TASK@@"
mode = "privileged"
oracle = "none"
oracle_evidence = "@@ORACLE_EVIDENCE@@"
expert_time_estimate_hours = 2.0

[verifier]
timeout_sec = 15000.0             # two fresh-process replays at tests/grade.py's limit for the longest accepted trajectory
                                  # (replay_timeout(15,000 actions) = 1200 s + actions / 2.5 = 7200 s each) + 600 s; a usual
                                  # trajectory (up to 1,500 actions) has 1800 s per replay
environment_mode = "separate"     # verifier runs in its own sandbox (tests/Dockerfile); the agent container is gone by then
network_mode = "no-network"       # Isaac Sim starts and renders offline: every asset is in the image

[verifier.environment]
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 32768

[agent]
timeout_sec = 5400.0              # RoboDojo budget, both modes: every Python process pays a few minutes of Isaac Sim launch + scene build
# RoboDojo's training demonstrations and policy checkpoints are public (Hugging Face), so the agent reaches the model APIs and the package registries,
# nothing else (scripts/set_agent_egress.py HOSTS).
network_mode = "allowlist"
allowed_hosts = ["chatgpt.com", "*.chatgpt.com", "auth.openai.com", "api.openai.com", "*.openai.com", "api.anthropic.com", "*.anthropic.com", "openrouter.ai", "*.openai.azure.com", "*.cognitiveservices.azure.com", "pypi.org", "files.pythonhosted.org", "deb.debian.org", "security.debian.org", "archive.ubuntu.com", "security.ubuntu.com", "snapshot.ubuntu.com"]

[environment]
build_timeout_sec = 3600.0
cpus = 8
memory_mb = 32768
