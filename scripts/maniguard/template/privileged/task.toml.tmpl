schema_version = "1.3"
artifacts = ["/app/output/"]

[task]
name = "robot-coding-bench/@@PRIV@@"
description = "ManiGuard (manipulation SAFETY benchmark; BEHAVIOR-1K v3.7.2 / OmniGibson on Isaac Sim 4.5, Franka Panda with long fin-ray fingers) @@MG_TASK@@: produce one replayable trajectory that completes the task while never breaking its LTLf safety specification. @@PROMPT_TOML@@ Frozen ManiGuard-Bench base task."
authors = [{ name = "qineng" }]
keywords = ["robotics", "maniguard", "safety", "ltl", "behavior", "omnigibson", "isaac-sim", "franka", "code-as-policy", "trajectory", "@@FAMILY@@"]

[metadata]
author_name = "qineng"
task_type = "trajectory"          # trajectory | policy   (see docs/PROTOCOL.md)
simulator = "maniguard"           # ManiGuard on BEHAVIOR-1K v3.7.2 (OmniGibson 3.7.2, Isaac Sim 4.5; PhysX on the CPU)
robot = "franka-panda-longfinger"
family = "@@FAMILY@@"
mode = "privileged"               # privileged state, resets and thin primitives through the tooling (docs/PROTOCOL.md §3)
oracle = "@@ORACLE@@"
@@ORACLE_EVIDENCE_LINE@@instance_seed = @@INDEX@@                 # = the ManiGuard-Bench task index (@@MG_TASK@@/base); scene = environment/instance/; identity = dataset.toml digest
expert_time_estimate_hours = 2.0
maniguard_task = "@@MG_TASK@@"
constraint_class = "@@CONSTRAINT_CLASS@@"
skill = "@@SKILL@@"
grasping = "@@GRASPING@@"

[verifier]
timeout_sec = 7200.0              # two fresh-process replays: Isaac Sim launch + scene load each, then the trajectory
environment_mode = "separate"     # verifier runs in its own sandbox (tests/Dockerfile); the agent container is gone by then

[agent]
timeout_sec = @@BUDGET@@.0             # ManiGuard budget, both modes (docs/benchmarks/maniguard.md)
network_mode = "allowlist"      # model APIs only (scripts/set_agent_egress.py): ManiGuard's demonstrations and data generator are public
allowed_hosts = @@ALLOWED_HOSTS@@

[environment]
build_timeout_sec = 3600.0
cpus = 8
memory_mb = 24576

[verifier.environment]
build_timeout_sec = 1800.0
