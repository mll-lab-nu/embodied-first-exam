# Standard mode: the agent container has NO simulator and no BEHAVIOR code — only Python and the client. The base image
# and the pip pins are the shared eai-standard client (scripts/eai_standard/client.env, client-requirements.txt).
FROM docker.io/library/python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
COPY client-requirements.txt /tmp/client-requirements.txt
RUN pip install --no-cache-dir -r /tmp/client-requirements.txt
COPY rcb_client.py rcb1.py /opt/tools/
ENV PYTHONPATH=/opt/tools
RUN mkdir -p /app/output
WORKDIR /app
