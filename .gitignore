.venv/
.venv-gs110/
.venv-gs121/
.venv-gs121-nyx/
.venv-harbor/
.cache/
.external/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
__nyx_cache__/
