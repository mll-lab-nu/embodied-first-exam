#!/bin/bash
# Oracle: run the human-written reference solution (kept in solution/, never in the agent image) and record it.
set -e
mkdir -p /app/output
python /opt/tools/rcb_robolab.py run-oracle --task @@FAMILY@@ --instance /app/instance.json --code /solution/oracle_@@FAMILY@@.py --out /app/output/trajectory.npz
cp /solution/oracle_@@FAMILY@@.py /app/output/gen.py
