+    if(block_count > 0)  // TopoGym determinism series (patch 0003): second pass
+    Launch(block_count, block_dim, 0, this->stream())
+        .kernel_name("segmental_reduce_cross_warp")
+        .apply(
+            [out          = out.viewer().name("out"),
+             in_size      = size,
+             get_key_op   = get_key_op,
+             get_value_op = get_value_op,
+             op           = op] __device__() mutable
+            {
+                // TopoGym determinism series (patch 0003): segments that cross a warp boundary, reduced in index order
+                int e = blockDim.x * blockIdx.x + threadIdx.x;
+                if(e >= static_cast<int>(in_size))
+                    return;
+                int key = get_key_op(e);
+                if(e > 0 && get_key_op(e - 1) == key)
+                    return;  // not a segment start
+                int last = e;
+                while(last + 1 < static_cast<int>(in_size) && get_key_op(last + 1) == key)
+                    ++last;
+                if(e / warp_size == last / warp_size)
+                    return;  // inside one warp: pass 1 wrote it
+                Matrix acc = get_value_op(e);
+                for(int k = e + 1; k <= last; ++k)
+                {
