<mujoco model="hand_racket">
  <!-- Draft: a tennis racket on the wrist mount (shaft along +z, head centre 0.53 m beyond the flange, face normal =
       local +x). The strings are a thin box; tennis / badminton set their own contact parameters. -->
  <worldbody>
    <body name="hand">
      <geom name="grip" type="capsule" fromto="0 0 0 0 0 0.20" size="0.017" mass="0.12" rgba="0.1 0.1 0.12 1" group="2"/>
      <geom name="throat" type="capsule" fromto="0 0 0.20 0 0 0.40" size="0.010" mass="0.05" rgba="0.85 0.85 0.9 1"
            group="2"/>
      <geom name="frame" type="ellipsoid" pos="0 0 0.53" size="0.012 0.10 0.135" mass="0.10" rgba="0.85 0.85 0.9 1"
            group="2"/>
      <geom name="strings" type="box" pos="0 0 0.53" size="0.004 0.09 0.125" mass="0.03" rgba="0.9 0.9 0.6 0.6"
            group="2"/>
      <site name="center" pos="0 0 0.53" size="0.005" group="4"/>
    </body>
  </worldbody>
</mujoco>
