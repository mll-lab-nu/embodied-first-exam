# Shared runtime, built once from the repository root. No API keys at build time.
FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu126
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOPOGYM_VISUAL_ASSET_ROOT=/opt/topogym-visuals \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=all
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl ca-certificates git build-essential ffmpeg libegl1 libgl1 libglib2.0-0 \
    libx11-6 libxext6 libxrender1 libvulkan1 libgomp1 libseccomp2 nodejs npm ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.30
COPY requirements/uv-topogym-gs121.txt requirements/uv-topogym-gs121-nyx.txt /opt/requirements/
RUN uv pip install --system torch==2.12.0 torchvision==0.27.0 --index-url ${TORCH_INDEX} \
    && uv pip install --system -r /opt/requirements/uv-topogym-gs121.txt \
        --overrides /opt/requirements/uv-topogym-gs121-nyx.txt \
    && uv pip install --system -r /opt/requirements/uv-topogym-gs121-nyx.txt \
    && uv pip install --system imageio imageio-ffmpeg pyuipc==0.0.25
WORKDIR /opt/topogym
COPY pyproject.toml ./
COPY topogym/ ./topogym/
COPY harbor_runners/ ./harbor_runners/
COPY configs/ ./configs/
COPY assets/ ./assets/
# External robot assets live outside the installed site-packages tree.
ENV TOPOGYM_ASSET_ROOT=/opt/topogym/assets
COPY scripts/prepare_nyx_studio.py ./scripts/prepare_nyx_studio.py
COPY tests/fixtures/cube_transfer.py /opt/topogym-fixtures/fixtures/cube_transfer.py
COPY tests/fixtures/cube_pick_place.py /opt/topogym-fixtures/fixtures/cube_pick_place.py
RUN uv pip install --system --no-deps . \
    && python -I -c "from topogym.assets.robot import asset_root; root = asset_root(); required = ('robots/robotiq_2f85/2f85.xml', 'robots/robotiq_2f85/assets', 'robots/aloha/aloha.xml', 'robots/aloha/assets', 'robots/aloha/joint_position_actuators.xml', 'robots/aloha/keyframe_ctrl.xml'); missing = [str(root / name) for name in required if not (root / name).exists()]; assert not missing, f'Missing robot assets: {missing}'; print(f'Robot assets ready: {root}')" \
    && python scripts/prepare_nyx_studio.py \
    && touch /opt/topogym-fixtures/fixtures/__init__.py \
    && useradd --uid 10001 --create-home --shell /bin/bash agent \
    && useradd --uid 10002 --create-home --shell /bin/false policy \
    && chmod 700 /home/agent /home/policy \
    && install -d -m 700 /trial /etc/topogym \
    && install -d -m 755 /rollout /run/topogym \
    && install -d -o agent -g agent -m 700 /workspace
WORKDIR /workspace
# Harbor's compose base overrides CMD. Generated tasks explicitly start worker.
CMD ["topogym-rollout-worker"]
