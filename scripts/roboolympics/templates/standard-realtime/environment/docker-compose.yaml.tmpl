# Standard-realtime mode (PROTOCOL §4b): the simulator runs in the `sim` sidecar (the agent cannot open it), on its own clock
# once an attempt starts (sim/rcb_realtime.py, the shared eai-standard/2.3 layer, with the standard twin's sim/server.py);
# the agent only reaches port 8000. No `expose`/`ports` on sim.
# GPU on sim: the physics is MuJoCo on the CPU, but every image the agent asks for is rendered here, and on a clock that
# does not stop a render is time the simulator cannot step: EGL on the GPU takes milliseconds a frame, OSMesa about 1.6 s
# in these venues. `graphics` is the capability that mounts the NVIDIA EGL driver (the image has the loader and manifest).
# Crash recovery: compose restarts a crashed service (same container, same /data) and the service replays its journal
# into the same attempt, paused, never a reset.
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
    working_dir: /tmp
    command: python /srv/rcb_realtime.py
    restart: on-failure:6                               # a crash resumes the same episode, never a reset (rcb_service.py)
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_DATA: /data
      RCB_WALL_CLOCK_S: "@@AGENT_TIMEOUT@@"
      RCB_STARTUP_TIMEOUT_S: "300"                      # the scene builds in under a second
      # Knobs: ${NAME:-default} takes NAME from the shell that runs harbor. The defaults are the standard
      # configuration; results under other settings are reported separately.
      RCB_SLOWDOWN: "${RCB_SLOWDOWN:-@@SLOWDOWN@@}"                # S = @@SLOWDOWN@@: the world runs at 1/S of real speed (the family's measured RTF; PROTOCOL §4b)
      RCB_RESET_BUDGET: "${RCB_RESET_BUDGET:-@@RT_RESET_BUDGET@@}"       # @@RT_RESET_BUDGET@@ resets (PROTOCOL §4b default); 0: one attempt
      RCB_SESSION_LOG: ""
      PYTHONPATH: /srv
      MUJOCO_GL: egl
      PYOPENGL_PLATFORM: egl
      NVIDIA_DRIVER_CAPABILITIES: compute,graphics,utility
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
