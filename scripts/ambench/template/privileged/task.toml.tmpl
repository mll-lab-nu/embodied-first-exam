# Generated by scripts/ambench/mk_tasks.py -- edit the template or scripts/ambench/descr/, not this.
schema_version = "1.3"
artifacts = ["/app/output/"]

[task]
name = "robot-coding-bench/@@PRIV@@"
description = "AM-Bench @@ENV_ID@@ (a fully actuated hexarotor with a 4-joint arm and a two-finger gripper, Isaac Lab / Isaac Sim 5.1): produce one replayable trajectory of AM-Bench's absolute end-effector pose actions at 120 Hz. @@GOAL_TOML@@ Frozen scene instance: AM-Bench's seeded reset, seed @@SEED@@; graded by AM-Bench's own success check in two fresh-process replays."
authors = [{ name = "Changhe Chen" }]
keywords = ["robotics", "ambench", "aerial-manipulation", "isaac-lab", "isaac-sim", "hexarotor", "code-as-policy", "trajectory", "privileged"]

[metadata]
author_name = "Changhe Chen"
author_org = "MLL Lab"
task_type = "trajectory"
simulator = "ambench"             # AM-Bench @ 60bf5b7 on Isaac Lab @ f4aa17f / Isaac Sim 5.1 (PhysX on the GPU, RTX rendering)
robot = "ambench-fahexa"
family = "@@FAMILY@@"
mode = "privileged"
oracle = "full"
instance_seed = @@SEED@@
expert_time_estimate_hours = 2.0

[verifier]
timeout_sec = 9000.0              # tests/grade.py's limits for the longest episode (3120 rows: 1500 s + 3120 / 4 = 2280 s per
                                  # process): two fresh-process replays (no cameras), one rerun of a replay that died early,
                                  # and the filmed illustration (cameras on; its time-out only costs the video); measured:
                                  # 1.5-6 min of Isaac start, the verifier's first one compiling its shaders, + 9-12 control
                                  # steps/s
environment_mode = "separate"     # verifier runs in its own sandbox (tests/Dockerfile); the agent container is gone by then
network_mode = "no-network"       # Isaac Sim starts and renders offline: every asset is in the image (images/ambench/web_assets.txt)

[verifier.environment]
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 24576

[agent]
timeout_sec = @@AGENT_TIMEOUT_S@@.0              # the agent's cutoff: scripts/task_cutoffs.toml, the one table (written by normalize, PROTOCOL §2.12)
# AM-Bench's scripted experts and its datasets are public upstream, so the agent reaches the model APIs and the package
# registries, nothing else (scripts/set_agent_egress.py HOSTS).
network_mode = "allowlist"
allowed_hosts = ["chatgpt.com", "*.chatgpt.com", "auth.openai.com", "api.openai.com", "*.openai.com", "api.anthropic.com", "*.anthropic.com", "openrouter.ai", "*.openai.azure.com", "*.cognitiveservices.azure.com", "pypi.org", "files.pythonhosted.org", "deb.debian.org", "security.debian.org", "archive.ubuntu.com", "security.ubuntu.com", "snapshot.ubuntu.com"]

[environment]
build_timeout_sec = 3600.0
cpus = 8
memory_mb = 24576
