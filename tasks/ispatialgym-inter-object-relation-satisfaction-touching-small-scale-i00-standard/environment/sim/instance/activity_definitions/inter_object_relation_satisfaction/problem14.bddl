(define (problem inter_object_relation_satisfaction-14)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-nextto_small_scale-marker-colored_pencil-breakfast_table)

    ; IORS - nextto (small-scale). Target and partner on the support with an init gap above the NextTo bound; the target
    ; is moved to the nearest position that satisfies NextTo (gap below mean(dims_a + dims_b)/6, adjacency rays), same
    ; orientation.

    (:objects
        marker.n.03_1 - marker.n.03
        pencil.n.01_1 - pencil.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop marker.n.03_1 breakfast_table.n.01_1)
        (ontop pencil.n.01_1 breakfast_table.n.01_1)
        (not (nextto marker.n.03_1 pencil.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (nextto ?marker.n.03_1 ?pencil.n.01_1)
            (not (grasped ?agent.n.01_1 ?marker.n.03_1))
            (not (grasped ?agent.n.01_1 ?pencil.n.01_1))
            (pose_settled ?marker.n.03_1)
            (pose_settled ?pencil.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?marker.n.03_1)
        (pose_reached ?pencil.n.01_1)
    )
)
