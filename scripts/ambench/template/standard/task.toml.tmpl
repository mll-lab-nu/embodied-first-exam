# Generated by scripts/ambench/mk_tasks.py -- edit the template or scripts/ambench/descr/, not this.
schema_version = "1.3"
artifacts = [
  { source = "/data/final.json", service = "sim" },
  { source = "/data/episode.jsonl", service = "sim" },
  { source = "/data/trajectory.npz", service = "sim" },
  { source = "/data/replay.mp4", service = "sim" },
  { source = "/data/replay.last.png", service = "sim" },
  { source = "/data/server.log", service = "sim" },            # the service's own output (Harbor keeps none)
  { source = "/data/journal.f64", service = "sim" },           # crash recovery: every executed control step (float64 rows)
  { source = "/data/startups.jsonl", service = "sim" },        # crash recovery: one line per service start
  { source = "/data/replay1.log", service = "sim" },           # the collect hook's two fresh-process replays
  { source = "/data/replay2.log", service = "sim" },
  "/app/output/",
]

[task]
name = "robot-coding-bench/@@STD@@"
description = "STANDARD MODE (robot as a service, eai-standard/2.2): AM-Bench @@ENV_ID@@ (a fully actuated hexarotor with a 4-joint arm and a two-finger gripper, Isaac Lab / Isaac Sim 5.1) @@TOML_INSTANCE@@ @@GOAL_TOML@@ The agent only gets a client: get_obs (RGB, depth + proprioception of the airframe and the arm), submit (AM-Bench's end-effector pose rows). No reset, no privileged state; @@TOML_GRADING@@"
authors = [{ name = "Changhe Chen" }]
keywords = ["robotics", "ambench", "aerial-manipulation", "isaac-lab", "isaac-sim", "hexarotor", "standard-mode", "trajectory"]

[metadata]
author_name = "Changhe Chen"
author_org = "MLL Lab"
task_type = "trajectory"
simulator = "ambench"             # AM-Bench @ 60bf5b7 on Isaac Lab @ f4aa17f / Isaac Sim 5.1 (PhysX on the GPU, RTX rendering)
robot = "ambench-fahexa"
family = "@@FAMILY@@"
mode = "standard"                 # robot as a service: RGB, depth + proprioception only; no object poses, no success predicate, no reset
dynamics = "static"               # scene dynamics (PROTOCOL §2): nothing but the robot does work on the scene
protocol = "eai-standard/2.2"
oracle = "full"
instance_seed = @@SEED@@
expert_time_estimate_hours = 3.0

[verifier]
timeout_sec = 1200.0
environment_mode = "separate"
network_mode = "no-network"

[[verifier.collect]]
service = "sim"
command = "sh /srv/finalize.sh"   # end + dump + exit the service, replay twice in fresh processes, film, write final.json
timeout_sec = 7200                # = finalize.sh's HOOK_BUDGET_S (RCB_COLLECT_TIMEOUT_S; keep them equal): the episode end (up to
                                  # 2700 s through a resume) + two camera-free fresh-process replays of at most one episode
                                  # (an Isaac start, 1.5-6 min, + up to 7200 control steps at 10-15 steps/s) + the filmed
                                  # illustration; finalize.sh ends a replay that would pass this deadline and records it

[agent]
timeout_sec = @@AGENT_TIMEOUT_S@@.0              # the agent's cutoff, this task's own (PROTOCOL §2.12)
# AM-Bench's scripted experts are public upstream, so the agent reaches the model APIs and the package registries, nothing
# else (scripts/set_agent_egress.py HOSTS).
network_mode = "allowlist"
allowed_hosts = ["chatgpt.com", "*.chatgpt.com", "auth.openai.com", "api.openai.com", "*.openai.com", "api.anthropic.com", "*.anthropic.com", "openrouter.ai", "*.openai.azure.com", "*.cognitiveservices.azure.com", "pypi.org", "files.pythonhosted.org", "deb.debian.org", "security.debian.org", "archive.ubuntu.com", "security.ubuntu.com", "snapshot.ubuntu.com"]

[environment]
build_timeout_sec = 3600.0
cpus = 4                          # the agent's container (the client only); the sim sidecar's caps: scripts/task_resources.toml
memory_mb = 10240
