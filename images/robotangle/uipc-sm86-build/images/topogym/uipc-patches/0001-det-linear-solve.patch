+#pragma once
+// Deterministic symmetric block SpMV (TopoGym determinism series, patch 0001).
+//
+// The symmetric BCOO matrix stores one triangle. Spmv::rbk_sym_spmv(_dot) scatters every off-diagonal block into two
+// block rows with atomic adds (y_i += A_ij x_j across warp segments, y_j += A_ij^T x_i) and atomically adds warp sums
+// into the dot product, so y and p^T A p round differently from run to run. DetSymSpmv instead expands A, after every
+// assembly, into a row-sorted block CSR holding both triangles (integer-only plan: cub radix sort of (row, col) keys;
+// then the blocks, transposed where needed, are copied into that order) and splits the block rows into short and long
+// ones. A short row gets 4 lanes (lane l sums the row's blocks l, l + 4, ... in order, a fixed xor butterfly combines
+// them); a long row (the affine-body rows that touch many contacts) gets a whole thread block (a fixed cub::BlockReduce
+// tree). The fused dot sums each lane group's rows in loop order and each thread block's groups in group order, and the
+// last thread block to finish sums the per-block partials in index order. Every partial sum has a fixed place in a fixed
+// order: no result depends on the scheduler.
+#include <algorithm>
+#include <type_define.h>
+#include <uipc/common/log.h>
+#include <linear_system/det_reduce.h>
+#include <muda/buffer/device_buffer.h>
+#include <muda/buffer/var_view.h>
+#include <muda/ext/linear_system/bcoo_matrix_view.h>
+#include <muda/ext/linear_system/dense_vector_view.h>
+
+namespace uipc::backend::cuda
+{
+class DetSymSpmv
+{
+  public:
+    // the expanded CSR of A's current values and sparsity (call after every assembly / conversion of A)
+    void build(muda::CBCOOMatrixView<Float, 3> A);
+
+    // y = a * A * x + b * y
+    void spmv(Float                           a,
+              muda::CBCOOMatrixView<Float, 3> A,
+              muda::CDenseVectorView<Float>   x,
+              Float                           b,
+              muda::DenseVectorView<Float>    y);
+
+    // y = a * A * x + b * y  and  d_dot = x^T (a * A * x)
+    void spmv_dot(Float                           a,
+                  muda::CBCOOMatrixView<Float, 3> A,
+                  muda::CDenseVectorView<Float>   x,
+                  Float                           b,
+                  muda::DenseVectorView<Float>    y,
+                  muda::VarView<Float>            d_dot);
+
+    bool built() const { return m_built; }
+
+
+  private:
+    void run(Float a, muda::CBCOOMatrixView<Float, 3> A, muda::CDenseVectorView<Float> x, Float b,
+             muda::DenseVectorView<Float> y, Float* dot_out);
+
+    bool              m_built    = false;
+    int               m_rows     = 0;
+    int               m_entries  = 0;
+    int               m_triplets = 0;
+    const Matrix3x3*  m_values   = nullptr;  // A's block storage at build time
+    int               m_n_short  = 0;
+    int               m_n_long   = 0;
+
+    muda::DeviceBuffer<int>                m_entry_counts;  // per triplet: 1 (diagonal) or 2
+    muda::DeviceBuffer<int>                m_entry_offsets;
+    muda::DeviceBuffer<unsigned long long> m_keys_in;
+    muda::DeviceBuffer<unsigned long long> m_keys_out;
+    muda::DeviceBuffer<int>                m_vals_in;  // 2 * triplet + transposed
+    muda::DeviceBuffer<int>                m_vals_out;
+    muda::DeviceBuffer<int>                m_row_counts;
+    muda::DeviceBuffer<int>                m_row_offsets;
+    muda::DeviceBuffer<Matrix3x3>          m_csr_blocks;  // row-sorted blocks of both triangles
+    muda::DeviceBuffer<int>                m_csr_cols;
+    muda::DeviceBuffer<int>                m_row_flag;   // 1 = long row
+    muda::DeviceBuffer<int>                m_row_pos;
+    muda::DeviceBuffer<int>                m_short_rows;
+    muda::DeviceBuffer<int>                m_long_rows;
+    det::SumScratch                        m_dot_scratch;  // fused dot: per-block partials + counter
+    muda::DeviceBuffer<std::byte>          m_temp;
+};
+}  // namespace uipc::backend::cuda
