(define (problem inter_object_relation_satisfaction-8)
    (:domain ispatialgym)
    (:variant inter_object_relation_satisfaction-inside_small_scale-hard_candy-hingeless_jar-coffee_table)

    ; IORS - inside (small-scale). Target lowered into the partner (fillable container) on the support; the target's
    ; goal orientation is whatever settles (TRO orientation_metric null), which also admits flowers stood in vases. Both
    ; poses measured. The insert grasp pipeline (pads on the upper part of the object so the lower body can enter the
    ; container; flowers held by the upper stem) is required.

    (:objects
        hard_candy.n.01_1 - hard_candy.n.01
        hingeless_jar.n.01_1 - hingeless_jar.n.01
        coffee_table.n.01_1 - coffee_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop hard_candy.n.01_1 coffee_table.n.01_1)
        (ontop hingeless_jar.n.01_1 coffee_table.n.01_1)
        (not (inside hard_candy.n.01_1 hingeless_jar.n.01_1))
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside ?hard_candy.n.01_1 ?hingeless_jar.n.01_1)
            (not (grasped ?agent.n.01_1 ?hard_candy.n.01_1))
            (not (grasped ?agent.n.01_1 ?hingeless_jar.n.01_1))
            (pose_settled ?hard_candy.n.01_1)
            (pose_settled ?hingeless_jar.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?hard_candy.n.01_1)
        (pose_reached ?hingeless_jar.n.01_1)
    )
)
