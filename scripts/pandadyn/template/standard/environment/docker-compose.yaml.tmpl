# Standard mode: the simulator runs in the `sim` sidecar (agent cannot open it); the agent only reaches port 8000.
# No `expose`/`ports` on sim: under Harbor's egress control it shares main's network namespace (localhost:8000).
# SAPIEN needs a Vulkan device (the NVIDIA GPU) to build the scene and render the cameras; physics is CPU PhysX. The
# sidecar is TRUSTED: ./sim (the frozen instance, the service, the tooling) is mounted only here, never where agent code runs.
# Crash recovery (docs/STANDARD_MODE.md §13): run.sh exits non-zero when the service crashes and compose restarts the
# same container (its /data kept); the service resumes the episode from its journal. RCB_STARTUP_TIMEOUT_S: the startup
# watchdog, many times the measured scene build (~5-15 s).
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
    working_dir: /tmp
    command: sh /srv/run.sh
    restart: on-failure:6
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_TEXTS: /srv/texts.json
      RCB_TOOL: /srv/rcb_pandadyn.py
      RCB_DATA: /data
      RCB_WALL_CLOCK_S: "@@AGENT_TIMEOUT_S@@"   # = task.toml [agent] timeout_sec (reported only: spec budget, meta time_left_s)
      RCB_STARTUP_TIMEOUT_S: "600"
      PYTHONPATH: /srv:/opt/pandadyn
      RCB_SESSION_LOG: ""           # the sidecar's own Session must not write the agent-side interaction log
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
