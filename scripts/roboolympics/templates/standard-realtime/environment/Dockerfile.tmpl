# Standard-realtime mode: the agent container has no simulator, no referee and no RoboOlympics code -- only Python and the realtime client (eai-standard/2.3).
FROM @@CLIENT_IMAGE@@
COPY client-requirements.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/client-requirements.txt
COPY rcb_client.py rcb1.py /opt/tools/
ENV PYTHONPATH=/opt/tools
RUN mkdir -p /app/output
WORKDIR /app
