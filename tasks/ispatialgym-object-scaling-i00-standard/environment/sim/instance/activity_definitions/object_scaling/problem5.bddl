(define (problem object_scaling-5)
    (:domain ispatialgym)
    (:variant object_scaling-bell_pepper)

    ; Object scaling. The target is held (right arm, fixed hold pose) at init and at the goal; the goal is a depth change of
    ; the target along the head-camera optical axis (TRO pose target: frame = head camera, position_metric = depth).

    (:objects
        bell_pepper.n.02_1 - bell_pepper.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (grasped agent.n.01_1 bell_pepper.n.02_1)
    )

    (:goal
        (and
            (grasped ?agent.n.01_1 ?bell_pepper.n.02_1)
            (pose_reached ?bell_pepper.n.02_1)
            (pose_settled ?bell_pepper.n.02_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?bell_pepper.n.02_1)
    )
)
