COPY . /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:libero-max-files-0.7.0@sha256:c7b1e76ccfe016dfad986426295f67d44cf43099fdd7f15b8e4b267b5e6d071f \
     /sim/finalize.sh \
     /privileged/environment/lmx_tool.py \
     /sim/rcb_service.py \
     /sim/server.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:standard-files-0.8.0@sha256:8a712f54d69d3fb089573d962c0756ef1026119a4337be28785e4a14410d20b3 /rcb1.py /srv/rcb1.py
