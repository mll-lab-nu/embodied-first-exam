(define (problem configuration_matching-3)
    (:domain ispatialgym)
    (:variant configuration_matching-articulation_close_small_scale-blender-breakfast_table)

    ; Configuration matching - articulation (small-scale, close). Spawned articulated object on the support, one joint open
    ; at q_init in S -> closed limit. Handle arm + brace arm (brace computed geometrically); root pose measured. Joint from
    ; the customs list (roles.target.joint / handle_key).

    (:objects
        blender.n.01_1 - blender.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (open blender.n.01_1)
        (ontop blender.n.01_1 breakfast_table.n.01_1)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (not (open ?blender.n.01_1))
            (ontop ?blender.n.01_1 ?breakfast_table.n.01_1)
            (not (grasped ?agent.n.01_1 ?blender.n.01_1))
            (pose_settled ?blender.n.01_1)
            (pose_settled ?agent.n.01_1)
        )
    )

    (:measure
        (pose_reached ?blender.n.01_1)
        (layout_reached ?blender.n.01_1)
    )
)
