# Standard-realtime mode (eai-standard/2.3): the simulator runs in the `sim` sidecar (the agent cannot open it) on a clock
# that does not stop once the episode has started; the agent only reaches port 8000.
# No `expose`/`ports` on sim. CPU only: MuJoCo physics and OSMesa rendering; no GPU reservation.
# Crash recovery (docs/STANDARD_MODE.md): compose restarts a crashed service (same container, same /data) and the
# service replays its journal (and the notes it names) into the same episode, never a reset.
services:
  main:
    depends_on: [sim]
  sim:
    image: @@IMAGE@@
    volumes:
      - ./sim:/srv:ro
    working_dir: /tmp
    command: python /srv/rcb_rsb_rt.py                  # server.py's adapter under rcb_realtime.py's clock
    restart: on-failure:6                               # a crash resumes the same episode, never a reset (rcb_service.py)
    environment:
      RCB_INSTANCE: /srv/instance.json
      RCB_DATA: /data
      RCB_WALL_CLOCK_S: "@@AGENT_TIMEOUT@@"
      RCB_STARTUP_TIMEOUT_S: "300"                      # the scene builds in a few seconds
      RCB_RESET_BUDGET: "0"                             # RoboSafeBench grades one episode: no reset
      # Knob: ${NAME:-default} takes NAME from the shell that runs harbor; results under another setting are reported apart.
      RCB_SLOWDOWN: "${RCB_SLOWDOWN:-@@SLOWDOWN@@}"                # 1: real time (official); S: one step every S x control_dt s
      PYTHONPATH: /srv
      MUJOCO_GL: osmesa
      PYOPENGL_PLATFORM: osmesa
