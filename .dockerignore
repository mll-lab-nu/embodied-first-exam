# Build context of images/topogym (scripts/build_images.sh builds from the repository root): only what the image COPYs.
**
!requirements/
!requirements/uv-topogym-gs121.txt
!requirements/uv-topogym-gs121-nyx.txt
!requirements/difficulty-eval-runtime.lock
!requirements/difficulty-eval-runtime-cu130.lock
!requirements/uipc-build.lock
!assets/
!assets/robots/
!assets/robots/**
!scripts/
!scripts/prepare_nyx_studio.py
!images/topogym/prune.py
!images/topogym/build_uipc.sh
!images/topogym/verify_uipc_wheel.py
!images/topogym/uipc-build.json
!images/topogym/uipc-build-cu130.json
!images/topogym/uipc-patches/
!images/topogym/uipc-patches/**
!images/topogym/check_gpu_stack.py
!images/topogym/genesis-1.2.1-cpu-tree.patch
!topogym/
!topogym/**
# no solutions in any image (images/topogym/prune.py removes them again after COPY)
topogym/agents
topogym/planning
topogym/data
topogym/**/deferred
topogym/**/legacy
topogym/**/redundants
topogym/**/rollout_simulation
**/*.md
# Relay robot identity includes the original robot documentation bytes.
!assets/robots/**/*.md
**/__pycache__/**
**/*.pyc
**/.env*
**/.secrets/**
