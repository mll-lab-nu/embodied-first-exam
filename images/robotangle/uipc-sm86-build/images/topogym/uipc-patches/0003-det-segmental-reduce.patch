+        .file_line(__FILE__, __LINE__)
+        .apply(
+            [out          = out.viewer().name("out"),
+             in_size      = size,
+             get_key_op   = get_key_op,
+             get_value_op = get_value_op,
+             op           = op] __device__() mutable
+            {
+                // TopoGym determinism series (patch 0003): segments that cross a warp boundary, reduced in index order
+                int e = blockDim.x * blockIdx.x + threadIdx.x;
+                if(e >= static_cast<int>(in_size))
+                    return;
