+                if(e / warp_size == last / warp_size)
+                    return;  // inside one warp: pass 1 wrote it
+                ValueT acc = get_value_op(e);
+                for(int k = e + 1; k <= last; ++k)
                 {
-                    if(flags.is_cross_warp)
